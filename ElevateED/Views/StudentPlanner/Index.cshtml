@model ElevateED.ViewModels.PlannerIndexViewModel
@{
    ViewBag.Title = "Study Planner - ElevateED";
    var p = Model.Progress;
    var active = Model.ActiveCard;
}

<style>
    .content { padding: 32px; }
    .page-head { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 12px; margin-bottom: 24px; }
    .page-head h1 { font-size: 26px; color: var(--gray-900); }
    .page-head p { color: var(--gray-500); margin-top: 4px; }

    .btn { display: inline-flex; align-items: center; gap: 8px; padding: 12px 22px; border-radius: 12px; font-weight: 600; font-size: 14px; text-decoration: none; border: none; cursor: pointer; }
    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: var(--primary-dark); }
    .btn-light { background: var(--gray-100); color: var(--gray-700); }
    .btn-danger { background: #fef2f2; color: #991b1b; }
    .btn-sm { padding: 8px 14px; font-size: 13px; }

    .alert-soft { padding: 14px 18px; border-radius: 12px; margin-bottom: 20px; font-size: 14px; display: flex; align-items: center; gap: 10px; }
    .alert-success { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
    .alert-error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }

    .empty { text-align: center; padding: 70px 20px; background: white; border-radius: 20px; border: 1px solid var(--gray-100); box-shadow: 0 2px 12px rgba(0,0,0,0.05); }
    .empty .big-icon { font-size: 56px; color: var(--primary-light); margin-bottom: 18px; }
    .empty h2 { font-size: 22px; color: var(--gray-800); margin-bottom: 8px; }
    .empty p { color: var(--gray-500); max-width: 480px; margin: 0 auto 22px; line-height: 1.6; }

    .stat-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 18px; margin-bottom: 26px; }
    .scard { background: white; border-radius: 16px; padding: 22px; box-shadow: 0 2px 12px rgba(0,0,0,0.05); border: 1px solid var(--gray-100); }
    .scard .icon { width: 46px; height: 46px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; color: white; margin-bottom: 12px; }
    .scard .val { font-size: 30px; font-weight: 800; color: var(--gray-900); }
    .scard .lab { font-size: 13px; color: var(--gray-500); }

    .ring { position: relative; width: 120px; height: 120px; margin: 0 auto; }

    .panel { background: white; border-radius: 16px; padding: 24px; box-shadow: 0 2px 12px rgba(0,0,0,0.05); border: 1px solid var(--gray-100); margin-bottom: 24px; }
    .panel h3 { font-size: 16px; color: var(--gray-800); margin-bottom: 18px; display: flex; justify-content: space-between; align-items: center; }

    .subj-bar { margin-bottom: 14px; }
    .subj-bar .top { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 5px; }
    .subj-bar .name { font-weight: 600; color: var(--gray-700); }
    .subj-bar .hrs { color: var(--gray-500); }
    .track { height: 10px; background: var(--gray-100); border-radius: 50px; overflow: hidden; }
    .fill { height: 100%; background: linear-gradient(90deg, var(--primary), var(--primary-light)); border-radius: 50px; }

    .plan-list { display: flex; flex-direction: column; gap: 12px; }
    .plan-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 18px; border: 1px solid var(--gray-100); border-radius: 12px; }
    .plan-row.active { border-color: var(--primary); background: var(--primary-bg); }
    .plan-row .pinfo strong { color: var(--gray-900); }
    .plan-row .pinfo .meta { font-size: 12px; color: var(--gray-500); margin-top: 2px; }
    .pill { padding: 3px 10px; border-radius: 50px; font-size: 11px; font-weight: 600; }
    .pill-active { background: var(--primary); color: white; }
    .plan-actions { display: flex; gap: 6px; align-items: center; }
</style>

<div class="app-container">
    @Html.Partial("_StudentSidebar")
    <main class="main-content">
        <header class="top-header">
            <div class="header-right">
                <a href="@Url.Action("Dashboard", "Student")" style="color: var(--primary); text-decoration: none; font-weight: 600; font-size: 14px;"><i class="fas fa-arrow-left"></i> Dashboard</a>
            </div>
        </header>

        <div class="content">
            <div class="page-head">
                <div>
                    <h1><i class="fas fa-calendar-day" style="color: var(--accent);"></i> Smart Study Planner</h1>
                    <p>A personal study schedule built around your exams and your weakest subjects.</p>
                </div>
                <div style="display:flex; gap:10px;">
                    <a href="@Url.Action("Readiness")" class="btn btn-light"><i class="fas fa-heart-pulse"></i> Exam readiness</a>
                    <a href="@Url.Action("Setup")" class="btn btn-primary"><i class="fas fa-plus"></i> New study plan</a>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert-soft alert-success"><i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert-soft alert-error"><i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]</div>
            }

            @if (active == null)
            {
                <div class="empty">
                    <div class="big-icon"><i class="fas fa-calendar-plus"></i></div>
                    <h2>No study plan yet</h2>
                    <p>
                        Create a plan and we'll build a week-by-week study timetable for you — giving more time to subjects
                        you're weaker in and ramping up revision as each exam approaches.
                    </p>
                    <a href="@Url.Action("Setup")" class="btn btn-primary"><i class="fas fa-wand-magic-sparkles"></i> Build my study plan</a>
                </div>
            }
            else
            {
                <div class="stat-cards">
                    <div class="scard">
                        <div class="icon" style="background: linear-gradient(135deg,#10b981,#34d399);"><i class="fas fa-check-double"></i></div>
                        <div class="val">@p.AdherencePercent%</div>
                        <div class="lab">Adherence (@p.Completed done / @p.Missed missed)</div>
                    </div>
                    <div class="scard">
                        <div class="icon" style="background: linear-gradient(135deg,#f59e0b,#fbbf24);"><i class="fas fa-fire"></i></div>
                        <div class="val">@p.StreakDays</div>
                        <div class="lab">Day study streak</div>
                    </div>
                    <div class="scard">
                        <div class="icon" style="background: linear-gradient(135deg,#4f46e5,#6366f1);"><i class="fas fa-hourglass-half"></i></div>
                        <div class="val">@p.CompletedHours<span style="font-size:16px;color:var(--gray-400);">/@p.PlannedHours h</span></div>
                        <div class="lab">Hours studied vs planned</div>
                    </div>
                    <div class="scard">
                        <div class="icon" style="background: linear-gradient(135deg,#ec4899,#f472b6);"><i class="fas fa-list-check"></i></div>
                        <div class="val">@p.Planned</div>
                        <div class="lab">Sessions still to do</div>
                    </div>
                </div>

                <div class="panel">
                    <h3>
                        <span>@active.Name</span>
                        <a href="@Url.Action("Calendar", new { id = active.Id })" class="btn btn-primary btn-sm"><i class="fas fa-calendar-week"></i> Open calendar</a>
                    </h3>
                    <p style="color:var(--gray-500); font-size:13px; margin-top:-8px; margin-bottom:18px;">
                        @active.StartDate.ToString("dd MMM yyyy") – @active.EndDate.ToString("dd MMM yyyy")
                        @if (!string.IsNullOrEmpty(active.GoalCareerName))
                        {
                            <a href="@Url.Action("Detail", "StudentCareer", new { id = active.GoalCareerId })"
                               style="display:inline-flex;align-items:center;gap:5px;margin-left:8px;padding:3px 12px;background:#fffbeb;border:1px solid #fde68a;border-radius:50px;color:#92400e;font-weight:600;font-size:12px;text-decoration:none;">
                                🎯 Working toward: @active.GoalCareerName
                            </a>
                        }
                    </p>

                    @if (p.BySubject.Any())
                    {
                        <div style="font-size:13px; font-weight:600; color:var(--gray-600); margin-bottom:12px;">Time per subject (completed / planned)</div>
                        foreach (var subj in p.BySubject)
                        {
                            var pct = subj.PlannedHours > 0 ? (int)Math.Round(subj.CompletedHours / subj.PlannedHours * 100) : 0;
                            <div class="subj-bar">
                                <div class="top">
                                    <span class="name">@subj.SubjectName</span>
                                    <span class="hrs">@subj.CompletedHours / @subj.PlannedHours h</span>
                                </div>
                                <div class="track"><div class="fill" style="width:@pct%;"></div></div>
                            </div>
                        }
                    }
                </div>
            }

            @if (Model.Plans.Count > 0)
            {
                <div class="panel">
                    <h3>All my plans</h3>
                    <div class="plan-list">
                        @foreach (var plan in Model.Plans)
                        {
                            <div class="plan-row @(plan.IsActive ? "active" : "")">
                                <div class="pinfo">
                                    <strong>@plan.Name</strong>
                                    @if (plan.IsActive)
                                    { <span class="pill pill-active">Active</span> }
                                    <div class="meta">
                                        @plan.StartDate.ToString("dd MMM") – @plan.EndDate.ToString("dd MMM yyyy") ·
                                        @plan.Completed done · @plan.Planned to do · @plan.Missed missed
                                    </div>
                                </div>
                                <div class="plan-actions">
                                    <a href="@Url.Action("Calendar", new { id = plan.Id })" class="btn btn-light btn-sm"><i class="fas fa-calendar-week"></i> Open</a>
                                    <form action="@Url.Action("Delete")" method="post" onsubmit="return confirm('Delete this study plan and all its sessions?');" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@plan.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </main>
</div>
