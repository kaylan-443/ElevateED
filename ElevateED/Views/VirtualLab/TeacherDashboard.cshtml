@model ElevateED.ViewModels.TeacherLabDashboardViewModel
@using ElevateED.Models
@using System.Web

@{
    ViewBag.Title = "Virtual Lab Management - Teacher";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<style>
    /* MAIN CONTENT AREA - Light background */
    .content-area {
        background: #f8f9fa;
        min-height: 100vh;
        padding: 30px;
    }

    /* Page Header */
    .page-header {
        background: white;
        border-radius: 16px;
        padding: 20px 25px;
        margin-bottom: 25px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        border: 1px solid #e5e7eb;
    }

        .page-header h1 {
            font-size: 24px;
            font-weight: 700;
            color: #4f46e5;
            margin: 0;
        }

        .page-header p {
            color: #6b7280;
            margin: 5px 0 0 0;
        }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 20px;
        padding: 25px 20px;
        text-align: center;
        border: 1px solid #e5e7eb;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        transition: all 0.3s;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

    .stat-number {
        font-size: 36px;
        font-weight: 800;
        color: #4f46e5;
        margin-bottom: 5px;
    }

        .stat-number.pending {
            color: #f59e0b;
        }

    .stat-lbl {
        font-size: 13px;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    /* Section Titles */
    .section-title {
        font-size: 18px;
        font-weight: 700;
        color: #4f46e5;
        margin: 30px 0 20px 0;
        padding-bottom: 12px;
        border-bottom: 3px solid #fbbf24;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .section-title i {
            color: #fbbf24;
            font-size: 20px;
        }

    /* Lab Cards */
    .lab-card {
        background: white;
        border-radius: 16px;
        padding: 22px;
        margin-bottom: 18px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
        transition: all 0.3s;
    }

        .lab-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.1);
        }

        .lab-card.pending-card {
            border-left: 5px solid #f59e0b;
            background: #fffbeb;
        }

    .lab-title {
        font-size: 18px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 10px;
    }

    .lab-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 12px;
    }

    /* Badges - HIGH CONTRAST */
    .badge-lab {
        display: inline-block;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge-biology {
        background: #10b981;
        color: white;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }

    .badge-chemistry {
        background: #f59e0b;
        color: white;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }

    .badge-physics {
        background: #3b82f6;
        color: white;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }

    .badge-difficulty {
        background: #e2e8f0;
        color: #1e293b;
        border: 1px solid #cbd5e1;
    }

    .lab-card p {
        color: #475569;
        font-size: 14px;
        margin: 10px 0;
        line-height: 1.5;
    }

    /* BUTTONS - HIGH VISIBILITY */
    .btn-launch {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 22px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
        border: none;
        margin-right: 10px;
        margin-top: 8px;
    }

        .btn-launch i {
            font-size: 14px;
        }

        .btn-launch:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(0,0,0,0.15);
            text-decoration: none;
        }

    .btn-primary-custom {
        background: #4f46e5;
        color: white !important;
    }

        .btn-primary-custom:hover {
            background: #4338ca;
            color: white !important;
        }

    .btn-success-custom {
        background: #10b981;
        color: white !important;
    }

        .btn-success-custom:hover {
            background: #059669;
            color: white !important;
        }

    .btn-warning-custom {
        background: #f59e0b;
        color: #1e1b4b !important;
    }

        .btn-warning-custom:hover {
            background: #d97706;
            color: white !important;
        }

    .btn-info-custom {
        background: #3b82f6;
        color: white !important;
    }

        .btn-info-custom:hover {
            background: #2563eb;
            color: white !important;
        }

    .btn-outline-custom {
        background: white;
        color: #4f46e5 !important;
        border: 2px solid #4f46e5;
    }

        .btn-outline-custom:hover {
            background: #4f46e5;
            color: white !important;
        }

    /* Assignment Card */
    .assignment-card {
        background: #f8fafc;
        border-radius: 14px;
        padding: 18px;
        margin-bottom: 14px;
        border: 1px solid #e2e8f0;
    }

    .assignment-title {
        font-weight: 700;
        color: #4f46e5;
        margin-bottom: 8px;
    }

    .assignment-meta {
        font-size: 13px;
        color: #64748b;
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 12px;
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 20px;
        border: 2px dashed #cbd5e1;
    }

        .empty-state i {
            font-size: 56px;
            color: #94a3b8;
            margin-bottom: 15px;
        }

        .empty-state h4 {
            color: #475569;
            margin-bottom: 8px;
        }

        .empty-state p {
            color: #94a3b8;
        }

    /* Create Button */
    .btn-create {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
        padding: 12px 28px;
        border-radius: 40px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s;
        border: none;
        font-size: 14px;
    }

        .btn-create:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
            color: white;
            text-decoration: none;
        }

    /* Warning note for manual assignment */
    .assignment-note {
        background: #fef3c7;
        border-left: 4px solid #f59e0b;
        padding: 12px 18px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 13px;
        color: #92400e;
    }

        .assignment-note i {
            margin-right: 8px;
            color: #f59e0b;
        }

        .assignment-note a {
            color: #d97706;
            font-weight: 600;
            text-decoration: none;
        }

            .assignment-note a:hover {
                text-decoration: underline;
            }

    /* Edit Tasks modal */
    .task-modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(15, 23, 42, 0.55);
        z-index: 1000;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

        .task-modal-overlay.show {
            display: flex;
        }

    .task-modal {
        background: white;
        border-radius: 20px;
        max-width: 600px;
        width: 100%;
        max-height: 85vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 50px rgba(0,0,0,0.25);
    }

    .task-modal-header {
        padding: 22px 26px;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .task-modal-header h3 {
            font-size: 18px;
            font-weight: 700;
            color: #4f46e5;
            margin: 0;
        }

        .task-modal-header button {
            background: none;
            border: none;
            font-size: 20px;
            color: #6b7280;
            cursor: pointer;
        }

    .task-modal-body {
        padding: 22px 26px;
        overflow-y: auto;
    }

    .task-modal-footer {
        padding: 18px 26px;
        border-top: 1px solid #e5e7eb;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    .task-modal-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        margin-bottom: 10px;
    }

        .task-modal-row.selected {
            border-color: #4f46e5;
            background: #eef2ff;
        }

        .task-modal-row input[type="checkbox"] {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
            cursor: pointer;
        }

        .task-modal-row label {
            flex: 1;
            font-size: 14px;
            color: #1e293b;
            cursor: pointer;
            margin: 0;
        }

        .task-modal-row .task-marks-input {
            width: 90px;
            padding: 8px 10px;
            border: 2px solid #cbd5e1;
            border-radius: 8px;
            font-size: 14px;
            text-align: center;
        }

            .task-modal-row .task-marks-input:disabled {
                background: #f1f5f9;
                color: #94a3b8;
            }
</style>

@Html.AntiForgeryToken()

<div class="content-area">
    <div class="page-header">
        <div>
            <h1><i class="fas fa-vr-cardboard" style="color: #8b5cf6;"></i> Virtual Lab Management</h1>
            <p>Create interactive 3D experiments, assign to classes, and grade student submissions</p>
        </div>
        <a href="@Url.Action("CreateExperiment", "VirtualLab")" class="btn-create">
            <i class="fas fa-plus-circle"></i> Create New Experiment
        </a>
    </div>

    <!-- Statistics Dashboard -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-number">@Model.Experiments.Count</div>
            <div class="stat-lbl">Total Experiments</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">@Model.Assignments.Count</div>
            <div class="stat-lbl">Active Assignments</div>
        </div>
        <div class="stat-card">
            <div class="stat-number pending">@Model.RecentResults.Count(r => r.Status == "Submitted")</div>
            <div class="stat-lbl">Pending Grading</div>
        </div>
    </div>

    <!-- Recent Results Section - most are auto-graded on submit; any still
         "Submitted" have no graded tasks configured and need manual grading -->
    @if (Model.RecentResults.Any())
    {
        <div class="section-title">
            <i class="fas fa-clipboard-check"></i> Recent Results
        </div>
        foreach (var sub in Model.RecentResults)
        {
            var needsGrading = sub.Status == "Submitted";
            <div class="lab-card @(needsGrading ? "pending-card" : "")">
                <div class="lab-title">
                    <i class="fas fa-flask" style="color: @(needsGrading ? "#f59e0b" : "#10b981"); margin-right: 8px;"></i>
                    @sub.Assignment.Experiment.Title
                </div>
                <div class="lab-meta">
                    <span class="badge-lab badge-@(sub.Assignment.Experiment.LabType.ToString().ToLower())">@sub.Assignment.Experiment.LabType Lab</span>
                    <span><i class="fas fa-user"></i> Student: @(sub.Student?.FullName)</span>
                    <span><i class="fas fa-calendar-check"></i> Submitted: @(sub.CompletedAt?.ToString("dd MMM yyyy, HH:mm"))</span>
                    @if (needsGrading)
                    {
                        <span class="badge-lab" style="background:#f59e0b;color:white;">Awaiting Grading</span>
                    }
                    else if (sub.AutoGraded)
                    {
                        <span class="badge-lab" style="background:#10b981;color:white;">Auto-Graded: @sub.Score / @sub.MaxScore</span>
                    }
                    else
                    {
                        <span class="badge-lab" style="background:#3b82f6;color:white;">Graded: @sub.Score</span>
                    }
                </div>
                <p><strong>Observations:</strong> @(sub.Observations?.Length > 100 ? sub.Observations.Substring(0, 100) + "..." : sub.Observations ?? "No observations recorded")</p>
                <div>
                    <a href="@Url.Action("GradeSubmissions", "VirtualLab", new { experimentId = sub.Assignment.ExperimentId })" class="btn-launch @(needsGrading ? "btn-warning-custom" : "btn-outline-custom")">
                        <i class="fas fa-@(needsGrading ? "check-double" : "eye")"></i> @(needsGrading ? "Grade Submission" : "Review")
                    </a>
                </div>
            </div>
        }
    }

    <!-- Active Assignments Section -->
    @if (Model.Assignments.Any())
    {
        <div class="section-title">
            <i class="fas fa-tasks"></i> Assigned Experiments
        </div>
        foreach (var assignment in Model.Assignments)
        {
            <div class="assignment-card">
                <div class="assignment-title">
                    <i class="fas fa-flask" style="color: #10b981;"></i> @assignment.Experiment.Title
                </div>
                <div class="assignment-meta">
                    <span><i class="fas fa-users"></i> Class: @(assignment.Class?.FullName)</span>
                    <span><i class="far fa-calendar-alt"></i> Assigned: @assignment.AssignedAt.ToString("dd MMM yyyy")</span>
                    <span><i class="fas fa-hourglass-half"></i> Due: @assignment.DueDate.ToString("dd MMM yyyy")</span>
                </div>
                <div>
                    <a href="@Url.Action("GradeSubmissions", "VirtualLab", new { experimentId = assignment.ExperimentId })" class="btn-launch btn-outline-custom">
                        <i class="fas fa-chart-line"></i> View Submissions
                    </a>
                </div>
            </div>
        }
    }

    <!-- All Experiments List -->
    <div class="section-title">
        <i class="fas fa-database"></i> Experiment Library
    </div>

    <!-- Note about manual assignment -->
    <div class="assignment-note">
        <i class="fas fa-info-circle"></i>
        <strong>Assigning Experiments:</strong> To assign an experiment to a class, please go to the experiment details page via the "Create New Experiment" button above, or use the "Grade Submissions" button to access and assign experiments.
    </div>

    @if (!Model.Experiments.Any())
    {
        <div class="empty-state">
            <i class="fas fa-flask"></i>
            <h4>No Experiments Created Yet</h4>
            <p>Get started by creating your first virtual lab experiment.</p>
            <a href="@Url.Action("CreateExperiment", "VirtualLab")" class="btn-create" style="margin-top: 15px;">
                <i class="fas fa-plus-circle"></i> Create First Experiment
            </a>
        </div>
    }
    else
    {
        foreach (var exp in Model.Experiments)
        {
            <div class="lab-card">
                <div class="lab-title">
                    @exp.Title
                </div>
                <div class="lab-meta">
                    <span class="badge-lab badge-@(exp.LabType.ToString().ToLower())">@exp.LabType Lab</span>
                    <span class="badge-lab badge-difficulty">@exp.Difficulty</span>
                    <span><i class="fas fa-star"></i> Grade @exp.GradeLevel</span>
                    <span><i class="fas fa-clock"></i> @exp.DurationMinutes mins</span>
                </div>
                <p>@exp.Description</p>
                <div>
                    <!-- Assign button REMOVED - only Grade Submissions remains -->
                    <a href="@Url.Action("GradeSubmissions", "VirtualLab", new { experimentId = exp.Id })" class="btn-launch btn-warning-custom">
                        <i class="fas fa-graduation-cap"></i> Grade Submissions
                    </a>
                    <button type="button"
                            class="btn-launch btn-outline-custom edit-tasks-btn"
                            data-experiment-id="@exp.Id"
                            data-lab-type="@exp.LabType"
                            data-title="@exp.Title">
                        <i class="fas fa-list-check"></i> Edit Graded Tasks
                    </button>
                </div>
            </div>
        }
    }
</div>

<!-- Edit Graded Tasks modal -->
<div class="task-modal-overlay" id="taskModalOverlay">
    <div class="task-modal">
        <div class="task-modal-header">
            <h3 id="taskModalTitle">Edit Graded Tasks</h3>
            <button type="button" onclick="closeTaskModal()">&times;</button>
        </div>
        <div class="task-modal-body">
            <p style="color:#6b7280; font-size: 13px; margin-top: 0;">
                Choose which checkpoints the simulation should grade for this experiment and how many
                marks each is worth. Students only need to complete the tasks selected here.
            </p>
            <div id="taskModalList">
                <p style="color:#94a3b8;">Loading...</p>
            </div>
        </div>
        <div class="task-modal-footer">
            <button type="button" class="btn-cancel-modal" onclick="closeTaskModal()" style="background:#e2e8f0;color:#1e293b;padding:10px 20px;border-radius:30px;border:none;font-weight:600;cursor:pointer;">Cancel</button>
            <button type="button" class="btn-save-modal" onclick="saveTaskModal()" style="background:linear-gradient(135deg,#10b981,#059669);color:white;padding:10px 24px;border-radius:30px;border:none;font-weight:700;cursor:pointer;">Save Tasks</button>
        </div>
    </div>
</div>

<script>
    // Simple dropdown toggle function if needed
    function toggleDropdown(): void {
        const dropdown = document.getElementById('profileDropdown');
        if (dropdown) dropdown.classList.toggle('show');
    }

    document.addEventListener('click', function (e: MouseEvent): void {
        const container = document.querySelector('.profile-container');
        const dropdown = document.getElementById('profileDropdown');
        if (container && dropdown && e.target instanceof Node && !container.contains(e.target)) {
            dropdown.classList.remove('show');
        }
    });

    // ---------- Edit Graded Tasks modal ----------
    interface TaskItem {
        key: string;
        label: string;
        selected: boolean;
        maxMarks: number;
    }

    interface TaskPick {
        key: string;
        label: string;
        maxMarks: number;
    }

    interface TasksResponse {
        success: boolean;
        message?: string;
        tasks: TaskItem[];
    }

    interface SaveResponse {
        success: boolean;
        message?: string;
    }

    let currentTaskModalExperimentId: number | null = null;

    function getAntiForgeryHeaders(): Record<string, string> {
        const tokenInput = document.querySelector<HTMLInputElement>('input[name="__RequestVerificationToken"]');
        const headers: Record<string, string> = {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest'
        };
        if (tokenInput) {
            headers['RequestVerificationToken'] = tokenInput.value;
        }
        return headers;
    }

    function openTaskModal(experimentId: number, labType: string, title: string): void {
        currentTaskModalExperimentId = experimentId;

        const titleEl = document.getElementById('taskModalTitle');
        const listEl = document.getElementById('taskModalList');
        const overlayEl = document.getElementById('taskModalOverlay');

        if (titleEl) titleEl.textContent = 'Edit Graded Tasks - ' + title;
        if (listEl) listEl.innerHTML = '<p style="color:#94a3b8;">Loading...</p>';
        if (overlayEl) overlayEl.classList.add('show');

        fetch('@Url.Action("GetExperimentTasks", "VirtualLab")?experimentId=' + experimentId, {
            method: 'GET',
            credentials: 'same-origin'
        })
            .then(function (r): Promise<TasksResponse> { return r.json(); })
            .then(function (data: TasksResponse): void {
                if (!data.success) {
                    if (listEl) listEl.innerHTML = '<p style="color:#ef4444;">' + (data.message || 'Could not load tasks.') + '</p>';
                    return;
                }
                renderTaskModalList(data.tasks);
            })
            .catch(function (): void {
                if (listEl) listEl.innerHTML = '<p style="color:#ef4444;">Network error loading tasks.</p>';
            });
    }

    function renderTaskModalList(tasks: TaskItem[]): void {
        const list = document.getElementById('taskModalList');
        if (!list) return;

        list.innerHTML = '';

        if (!tasks || !tasks.length) {
            list.innerHTML = '<p style="color:#94a3b8;">No gradable checkpoints are defined for this lab type.</p>';
            return;
        }

        tasks.forEach(function (task: TaskItem): void {
            const row = document.createElement('div');
            row.className = 'task-modal-row' + (task.selected ? ' selected' : '');
            row.setAttribute('data-key', task.key);
            row.setAttribute('data-label', task.label);

            const checkboxId = 'modalTaskChk_' + task.key;

            const checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.id = checkboxId;
            checkbox.checked = !!task.selected;

            const label = document.createElement('label');
            label.setAttribute('for', checkboxId);
            label.textContent = task.label;

            const marksInput = document.createElement('input');
            marksInput.type = 'number';
            marksInput.className = 'task-marks-input';
            marksInput.min = '1';
            marksInput.max = '100';
            marksInput.value = String(task.maxMarks && task.maxMarks > 0 ? task.maxMarks : 10);
            marksInput.disabled = !task.selected;

            checkbox.addEventListener('change', function (): void {
                marksInput.disabled = !checkbox.checked;
                row.classList.toggle('selected', checkbox.checked);
            });

            row.appendChild(checkbox);
            row.appendChild(label);
            row.appendChild(marksInput);
            list.appendChild(row);
        });
    }

    function closeTaskModal(): void {
        const overlayEl = document.getElementById('taskModalOverlay');
        if (overlayEl) overlayEl.classList.remove('show');
        currentTaskModalExperimentId = null;
    }

    function saveTaskModal(): void {
        if (currentTaskModalExperimentId === null) return;

        const picks: TaskPick[] = [];
        const rows = document.querySelectorAll<HTMLDivElement>('#taskModalList .task-modal-row');

        rows.forEach(function (row: HTMLDivElement): void {
            const checkbox = row.querySelector<HTMLInputElement>('input[type="checkbox"]');
            const marksInput = row.querySelector<HTMLInputElement>('.task-marks-input');

            if (checkbox && checkbox.checked && marksInput) {
                const marks = parseFloat(marksInput.value);
                if (!isNaN(marks) && marks > 0) {
                    picks.push({
                        key: row.getAttribute('data-key') || '',
                        label: row.getAttribute('data-label') || '',
                        maxMarks: marks
                    });
                }
            }
        });

        const body =
            'experimentId=' + encodeURIComponent(String(currentTaskModalExperimentId)) +
            '&tasksJson=' + encodeURIComponent(JSON.stringify(picks));

        fetch('@Url.Action("SaveExperimentTasks", "VirtualLab")', {
            method: 'POST',
            credentials: 'same-origin',
            headers: getAntiForgeryHeaders(),
            body: body
        })
            .then(function (r): Promise<SaveResponse> { return r.json(); })
            .then(function (data: SaveResponse): void {
                if (data.success) {
                    closeTaskModal();
                } else {
                    alert(data.message || 'Could not save tasks.');
                }
            })
            .catch(function (): void {
                alert('Network error saving tasks.');
            });
    }

    // ---------- Wire up Edit Graded Tasks buttons ----------
    document.querySelectorAll<HTMLButtonElement>('.edit-tasks-btn').forEach(function (btn: HTMLButtonElement): void {
        btn.addEventListener('click', function (this: HTMLButtonElement): void {
            const id = parseInt(this.getAttribute('data-experiment-id') || '0', 10);
            const labType = this.getAttribute('data-lab-type') || '';
            const title = this.getAttribute('data-title') || '';
            openTaskModal(id, labType, title);
        });
    });
</script>