@model List<ElevateED.Models.VirtualLabResult>
@using ElevateED.Models

@{
    ViewBag.Title = "My Lab Results";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewBag.ActivePage = "virtuallab";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }


    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: var(--gray-50);
    }
















    .content-area {
        padding: 32px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 15px;
    }

        .page-header h1 {
            font-size: 26px;
            font-weight: 700;
            color: var(--gray-900);
        }

    .btn-primary {
        background: var(--primary);
        color: white;
        padding: 10px 20px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .result-card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 16px;
        border: 1px solid var(--gray-200);
        border-left: 4px solid var(--gray-300);
    }

        .result-card.graded {
            border-left-color: var(--success);
        }

        .result-card.pending {
            border-left-color: var(--warning);
        }

    .result-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 15px;
    }

        .result-header h3 {
            margin: 0 0 8px 0;
            font-size: 18px;
            font-weight: 600;
            color: var(--gray-900);
        }

    .lab-meta {
        display: flex;
        gap: 15px;
        font-size: 12px;
        color: var(--gray-500);
        flex-wrap: wrap;
    }

    .badge-lab {
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
    }

    .badge-biology {
        background: #d1fae5;
        color: #065f46;
    }

    .badge-chemistry {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-physics {
        background: #dbeafe;
        color: #1e40af;
    }

    .score-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 18px;
    }

    .score-high {
        background: #d1fae5;
        color: #065f46;
    }

    .score-medium {
        background: #fef3c7;
        color: #92400e;
    }

    .score-low {
        background: #fee2e2;
        color: #991b1b;
    }

    .score-pending {
        background: var(--gray-100);
        color: var(--gray-600);
    }

    .feedback-box {
        margin-top: 12px;
        padding: 12px;
        background: var(--gray-50);
        border-radius: 10px;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 16px;
        border: 1px solid var(--gray-200);
    }

        .empty-state i {
            font-size: 48px;
            color: var(--gray-400);
            margin-bottom: 15px;
        }


    @@media (max-width: 768px) {
        .content-area {
            padding: 20px;
        }

        .result-header {
            flex-direction: column;
        }
    }
</style>

        <div class="content-area">
            <div class="page-header">
                <div>
                    <h1><i class="fas fa-chart-line" style="color: var(--info);"></i> My Lab Results</h1>
                    <p>View your completed virtual lab experiments and feedback</p>
                </div>
                <a href="@Url.Action("Index", "VirtualLab")" class="btn-primary" style="background: var(--gray-500);">
                    <i class="fas fa-arrow-left"></i> Back to Lab
                </a>
            </div>

            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="fas fa-flask"></i>
                    <h4>No Lab Results Yet</h4>
                    <p>Complete a virtual lab experiment to see your results here.</p>
                </div>
            }
            else
            {
                foreach (var result in Model.OrderByDescending(r => r.CompletedAt))
                {
                    var statusClass = result.Status == "Graded" ? "graded" : "pending";
                    var scoreClass = result.Score >= 70 ? "score-high" : result.Score >= 50 ? "score-medium" : result.Score.HasValue ? "score-low" : "score-pending";

                    <div class="result-card @statusClass">
                        <div class="result-header">
                            <div>
                                <h3>@result.Assignment.Experiment.Title</h3>
                                <div class="lab-meta">
                                    <span class="badge-lab badge-@result.Assignment.Experiment.LabType.ToString().ToLower()">@result.Assignment.Experiment.LabType Lab</span>
                                    <span><i class="fas fa-calendar"></i> Completed: @result.CompletedAt?.ToString("dd MMM yyyy, HH:mm")</span>
                                    @if (result.Assignment.DueDate != null)
                                    {
                                        <span><i class="fas fa-hourglass-half"></i> Due: @result.Assignment.DueDate.ToString("dd MMM yyyy")</span>
                                    }
                                </div>
                            </div>
                            <div>
                                <div class="score-circle @scoreClass">
                                    @if (result.Score.HasValue)
                                    {
                                        @($"{result.Score.Value}%")
                                    }
                                    else
                                    {
                                        <text>Pending</text>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(result.Observations))
                        {
                            <div style="margin-top: 15px; padding: 12px; background: var(--gray-50); border-radius: 10px;">
                                <strong><i class="fas fa-eye"></i> Your Observations:</strong>
                                <p style="margin: 8px 0 0 0;">@result.Observations</p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(result.Conclusions))
                        {
                            <div style="margin-top: 15px; padding: 12px; background: var(--gray-50); border-radius: 10px;">
                                <strong><i class="fas fa-lightbulb"></i> Your Conclusions:</strong>
                                <p style="margin: 8px 0 0 0;">@result.Conclusions</p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(result.TeacherFeedback))
                        {
                            <div class="feedback-box">
                                <strong><i class="fas fa-chalkboard-teacher"></i> Teacher Feedback:</strong>
                                <p style="margin: 8px 0 0 0;">@result.TeacherFeedback</p>
                            </div>
                        }

                        @if (result.GradedAt.HasValue)
                        {
                            <div style="margin-top: 10px; font-size: 12px; color: var(--gray-500);">
                                <i class="fas fa-clock"></i> Graded on: @result.GradedAt.Value.ToString("dd MMM yyyy, HH:mm")
                            </div>
                        }
                    </div>
                }
            }
        </div>

<script>
    function toggleDropdown() {
        var dropdown = document.getElementById('profileDropdown');
        if (dropdown) dropdown.classList.toggle('show');
    }

    document.addEventListener('click', function (e) {
        var container = document.querySelector('.profile-container');
        var dropdown = document.getElementById('profileDropdown');
        if (container && dropdown && !container.contains(e.target)) {
            dropdown.classList.remove('show');
        }
    });
</script>