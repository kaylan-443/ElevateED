@model List<ElevateED.Models.VirtualLabResult>
@using ElevateED.Models
@using Newtonsoft.Json.Linq

@{
    ViewBag.Title = "Grade Submissions - " + ViewBag.Experiment.Title;
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    var experiment = ViewBag.Experiment as ElevateED.Models.VirtualLabExperiment;
}

<style>
    .submission-card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 20px;
        border: 1px solid var(--gray-200);
        border-left: 4px solid var(--warning);
    }

    .grade-input {
        width: 80px;
        padding: 8px;
        border: 2px solid var(--gray-200);
        border-radius: 8px;
        text-align: center;
        font-size: 14px;
    }

    .feedback-textarea {
        width: 100%;
        padding: 10px;
        border: 2px solid var(--gray-200);
        border-radius: 10px;
        margin-top: 10px;
        resize: vertical;
    }

    .btn-save {
        background: var(--success);
        color: white;
        padding: 8px 20px;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        font-weight: 500;
        margin-top: 10px;
    }

        .btn-save:hover {
            background: #059669;
        }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 16px;
        border: 1px solid var(--gray-200);
    }

    .autograde-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        background: #d1fae5;
        color: #065f46;
    }

    .pending-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        background: #fef3c7;
        color: #92400e;
    }

    .task-breakdown {
        margin: 15px 0;
        padding: 12px;
        background: var(--gray-50);
        border-radius: 10px;
    }

    .task-breakdown-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 6px 0;
        font-size: 13px;
        border-bottom: 1px solid var(--gray-200);
    }

        .task-breakdown-row:last-child {
            border-bottom: none;
        }

        .task-breakdown-row .task-status-done {
            color: #10b981;
        }

        .task-breakdown-row .task-status-missed {
            color: #ef4444;
        }
</style>

<div class="content-area">
    <div class="page-header">
        <div>
            <h1><i class="fas fa-graduation-cap"></i> Grade Submissions</h1>
            <p>@experiment.Title - @experiment.LabType Lab</p>
        </div>
        <a href="@Url.Action("TeacherDashboard", "VirtualLab")" class="btn-primary" style="background: var(--gray-500);">
            <i class="fas fa-arrow-left"></i> Back
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-check-circle" style="color: var(--success);"></i>
            <h4>No Submissions Yet</h4>
            <p>No students have submitted this experiment yet.</p>
        </div>
    }
    else
    {
        foreach (var submission in Model)
        {
            var isGraded = submission.Status == "Graded";
            JArray breakdown = null;
            if (submission.AutoGraded && !string.IsNullOrEmpty(submission.TaskScoresJson))
            {
                try { breakdown = JArray.Parse(submission.TaskScoresJson); } catch { breakdown = null; }
            }
            var maxForInput = submission.MaxScore ?? 100;

            <div class="submission-card" id="submission-@submission.Id" style="@(isGraded ? "border-left-color: var(--success);" : "")">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 15px;">
                    <div>
                        <h3 style="margin: 0;">@submission.Student?.FullName</h3>
                        <p style="margin: 5px 0 0 0; color: var(--gray-500);">
                            Student #: @submission.Student?.User?.StudentNumber
                        </p>
                    </div>
                    <div style="text-align: right;">
                        <small>Submitted: @submission.CompletedAt?.ToString("dd MMM yyyy, HH:mm")</small><br />
                        @if (submission.AutoGraded)
                        {
                            <span class="autograde-badge"><i class="fas fa-robot"></i> Auto-Graded: @submission.Score / @submission.MaxScore</span>
                        }
                        else if (isGraded)
                        {
                            <span class="autograde-badge"><i class="fas fa-user-check"></i> Graded: @submission.Score</span>
                        }
                        else
                        {
                            <span class="pending-badge"><i class="fas fa-clock"></i> Awaiting Grading</span>
                        }
                    </div>
                </div>

                @if (breakdown != null && breakdown.Count > 0)
                {
                    <div class="task-breakdown">
                        <strong><i class="fas fa-list-check"></i> Task Breakdown:</strong>
                        @foreach (var task in breakdown)
                        {
                            var done = task["completed"] != null && task["completed"].Value<bool>();
                            <div class="task-breakdown-row">
                                <span>@task["label"]?.ToString()</span>
                                <span class="@(done ? "task-status-done" : "task-status-missed")">
                                    <i class="fas fa-@(done ? "check-circle" : "times-circle")"></i>
                                    @(done ? task["maxMarks"] + " / " + task["maxMarks"] : "0 / " + task["maxMarks"])
                                </span>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(submission.Observations))
                {
                    <div style="margin: 15px 0; padding: 12px; background: var(--gray-50); border-radius: 10px;">
                        <strong><i class="fas fa-eye"></i> Student Observations:</strong>
                        <p style="margin: 8px 0 0 0;">@submission.Observations</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(submission.Conclusions))
                {
                    <div style="margin: 15px 0; padding: 12px; background: var(--gray-50); border-radius: 10px;">
                        <strong><i class="fas fa-lightbulb"></i> Conclusions:</strong>
                        <p style="margin: 8px 0 0 0;">@submission.Conclusions</p>
                    </div>
                }

                <div style="margin-top: 15px;">
                    <label style="font-weight: 600;">
                        Score (0-@maxForInput)@(submission.AutoGraded ? " - override if needed:" : ":")
                    </label>
                    <input type="number" id="score-@submission.Id" class="grade-input" min="0" max="@maxForInput" step="1"
                           value="@(submission.Score.HasValue ? submission.Score.Value.ToString("0.##") : "")" />
                    <input type="hidden" id="maxscore-@submission.Id" value="@maxForInput" />

                    <label style="font-weight: 600; margin-top: 10px; display: block;">Feedback:</label>
                    <textarea id="feedback-@submission.Id" class="feedback-textarea" rows="3"
                              placeholder="Provide feedback to the student...">@submission.TeacherFeedback</textarea>

                    <button class="btn-save" onclick="saveGrade(@submission.Id)">
                        <i class="fas fa-save"></i> @(isGraded ? "Update Grade" : "Save Grade")
                    </button>
                </div>
            </div>
        }
    }
</div>

<script>
    function saveGrade(resultId) {
        var score = document.getElementById('score-' + resultId).value;
        var maxScore = document.getElementById('maxscore-' + resultId).value;
        var feedback = document.getElementById('feedback-' + resultId).value;

        if (score === '') {
            alert('Please enter a score');
            return;
        }

        if (score < 0 || score > maxScore) {
            alert('Score must be between 0 and ' + maxScore);
            return;
        }

        fetch('@Url.Action("SaveGrade", "VirtualLab")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({
                resultId: resultId,
                score: parseFloat(score),
                maxScore: parseFloat(maxScore),
                feedback: feedback
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('Grade saved successfully!');
                document.getElementById('submission-' + resultId).style.opacity = '0.6';
                document.getElementById('submission-' + resultId).style.borderLeftColor = '#10b981';
            } else {
                alert('Error: ' + data.message);
            }
        })
        .catch(error => {
            alert('An error occurred. Please try again.');
        });
    }
</script>