@model Dictionary<ElevateED.Models.DonationCategory, List<ElevateED.Models.DonationRequestItem>>
@{
    ViewBag.Title = "Priority Waitlist";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.ActiveTab = "waitlist";
}

<style>
    .page-header { margin-bottom: 20px; }
    .page-header h1 { font-size: 24px; font-weight: 700; color: var(--gray-900, #111827); display: flex; align-items: center; gap: 10px; }

    .category-panel { background: white; border: 1px solid var(--gray-200, #e5e7eb); border-radius: 16px; padding: 24px; margin-bottom: 20px; }
    .category-title { font-size: 15px; font-weight: 700; color: var(--gray-900, #111827); margin-bottom: 16px; display: flex; align-items: center; gap: 10px; }
    .category-count { background: var(--gray-100, #f3f4f6); color: var(--gray-600, #4b5563); font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 10px; }

    .wl-row { display: flex; align-items: center; gap: 14px; padding: 12px 0; border-bottom: 1px solid var(--gray-100, #f3f4f6); }
    .wl-row:last-child { border-bottom: none; }
    .wl-rank { width: 28px; height: 28px; border-radius: 50%; background: var(--primary, #4f46e5); color: white; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; flex-shrink: 0; }
    .wl-rank.top3 { background: linear-gradient(135deg, #f59e0b, #d97706); }
    .wl-body { flex: 1; }
    .wl-name { font-weight: 600; font-size: 13px; color: var(--gray-900, #111827); }
    .wl-meta { font-size: 12px; color: var(--gray-500, #6b7280); margin-top: 2px; }
    .wl-score { font-size: 12px; font-weight: 700; color: var(--primary, #4f46e5); }

    .empty-mini { text-align: center; padding: 20px; color: var(--gray-400, #9ca3af); font-size: 13px; }
</style>

@{ Html.RenderPartial("_DonationSubNav"); }

<div class="page-header">
    <h1><i class="fas fa-sort-amount-down" style="color: #ef4444;"></i> Priority Waitlist</h1>
</div>

@if (Model == null || !Model.Any(kv => kv.Value.Any()))
{
    <div class="category-panel"><div class="empty-mini">No learners are currently waitlisted.</div></div>
}
else
{
    foreach (var kv in Model)
    {
        if (!kv.Value.Any()) { continue; }
        <div class="category-panel">
            <div class="category-title">
                <i class="fas fa-tag"></i> @kv.Key <span class="category-count">@kv.Value.Count waitlisted</span>
            </div>
            @{ var rank = 0; }
            @foreach (var item in kv.Value)
            {
                rank++;
                var daysWaiting = item.DonationRequest != null ? (DateTime.Now - item.DonationRequest.RequestDate).Days : 0;
                <div class="wl-row">
                    <div class="wl-rank @(rank <= 3 ? "top3" : "")">@rank</div>
                    <div class="wl-body">
                        <div class="wl-name">@(item.DonationRequest != null && item.DonationRequest.Student != null ? item.DonationRequest.Student.FullName : "—") — @item.ItemName</div>
                        <div class="wl-meta">@item.Priority priority · Qty @item.QuantityRequested · Waiting @daysWaiting day(s)</div>
                    </div>
                    <div class="wl-score">Score: @(item.DonationRequest != null ? item.DonationRequest.PriorityScore : 0)</div>
                </div>
            }
        </div>
    }
}
