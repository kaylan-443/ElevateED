@model List<ElevateED.Models.DonationDistributionViewModel>
@{
    ViewBag.Title = "My Collections";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewBag.ActivePage = "donations";
    ViewBag.ActiveTab = "mycollections";
}

<style>
    .page-header { margin-bottom: 20px; }
    .page-header h1 { font-size: 24px; font-weight: 700; color: var(--gray-900, #111827); display: flex; align-items: center; gap: 10px; }

    .collection-card { background: white; border: 1px solid var(--gray-200, #e5e7eb); border-radius: 16px; padding: 22px 24px; margin-bottom: 18px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
    .collection-title { font-weight: 700; font-size: 15px; color: var(--gray-900, #111827); }
    .collection-meta { font-size: 12px; color: var(--gray-500, #6b7280); margin-top: 4px; }

    .code-box { text-align: center; background: linear-gradient(135deg, var(--primary, #4f46e5), #8b5cf6); color: white; border-radius: 14px; padding: 14px 24px; }
    .code-label { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.85; }
    .code-value { font-size: 20px; font-weight: 800; font-family: monospace; letter-spacing: 2px; margin-top: 4px; }

    .badge { padding: 4px 12px; border-radius: 10px; font-size: 11px; font-weight: 700; }
    .badge-pending { background: #fef3c7; color: #92400e; }
    .badge-awaiting { background: #dbeafe; color: #1e40af; }
    .badge-collected { background: #d1fae5; color: #065f46; }
    .badge-unclaimed { background: #fee2e2; color: #991b1b; }

    .empty-state { text-align: center; padding: 60px 20px; background: white; border-radius: 16px; border: 1px solid var(--gray-200, #e5e7eb); }
    .empty-state i { font-size: 48px; color: var(--gray-300, #d1d5db); margin-bottom: 15px; }
</style>

@{ Html.RenderPartial("_DonationSubNav"); }

<div class="page-header">
    <h1><i class="fas fa-box-open" style="color: var(--primary, #4f46e5);"></i> My Collections</h1>
</div>

@if (Model == null || !Model.Any())
{
    <div class="empty-state">
        <i class="fas fa-box-open"></i>
        <h4>Nothing matched yet</h4>
        <p style="color:var(--gray-500,#6b7280);">When a donated item is matched to one of your requests, it'll show up here with a collection code.</p>
    </div>
}
else
{
    foreach (var c in Model)
    {
        var badgeClass = c.Status == "AwaitingCollection" ? "badge-awaiting"
                        : c.Status == "Collected" ? "badge-collected"
                        : c.Status == "Unclaimed" ? "badge-unclaimed"
                        : "badge-pending";
        <div class="collection-card">
            <div>
                <div class="collection-title">@c.ItemName <span style="color:var(--gray-400,#9ca3af); font-weight:400;">(@c.ItemType)</span></div>
                <div class="collection-meta">
                    Qty @c.Quantity
                    @if (c.ScheduledDate.HasValue)
                    {
                        <text> &middot; Collection date: @c.ScheduledDate.Value.ToString("dd MMM yyyy")</text>
                    }
                    <br /><span class="badge @badgeClass">@c.Status</span>
                </div>
            </div>
            @if (c.Status == "AwaitingCollection" && !string.IsNullOrEmpty(c.CollectionToken))
            {
                <div class="code-box">
                    <div class="code-label">Collection Code</div>
                    <div class="code-value">@c.CollectionToken</div>
                </div>
            }
        </div>
    }
}
