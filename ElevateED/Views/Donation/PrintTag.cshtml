@model ElevateED.Models.DonationItem
@{
    ViewBag.Title = "Print QR Tag";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.ActiveTab = "intake";
}

<style>
    @@media print {
        .no-print { display: none !important; }
        .content-area { padding: 0 !important; }
        .top-header, .sidebar { display: none !important; }
        .main-content { margin-left: 0 !important; }
    }

    .page-header { margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
    .page-header h1 { font-size: 24px; font-weight: 700; color: var(--gray-900, #111827); display: flex; align-items: center; gap: 10px; }
    .btn-print { background: var(--primary, #4f46e5); color: white; border: none; padding: 10px 20px; border-radius: 12px; font-weight: 600; font-size: 13px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }

    .tag-wrap { display: flex; justify-content: center; }
    .tag-card {
        width: 340px; background: white; border: 2px solid var(--gray-900, #111827); border-radius: 16px; padding: 28px;
        text-align: center;
    }
    .tag-brand { font-size: 12px; font-weight: 700; letter-spacing: 1px; color: var(--primary, #4f46e5); text-transform: uppercase; margin-bottom: 4px; }
    .tag-item-name { font-size: 18px; font-weight: 800; color: var(--gray-900, #111827); margin-bottom: 4px; }
    .tag-category { font-size: 12px; color: var(--gray-500, #6b7280); margin-bottom: 16px; }
    #qrcode { display: flex; justify-content: center; margin-bottom: 16px; }
    .tag-code { font-family: monospace; font-size: 14px; font-weight: 700; letter-spacing: 1px; color: var(--gray-800, #1f2937); background: var(--gray-50, #f9fafb); padding: 8px; border-radius: 8px; margin-bottom: 8px; }
    .tag-instructions { font-size: 11px; color: var(--gray-400, #9ca3af); }
</style>

@{ Html.RenderPartial("_DonationSubNav"); }

<div class="page-header no-print">
    <h1><i class="fas fa-qrcode" style="color: #4f46e5;"></i> QR Tag &mdash; @Model.ItemName</h1>
    <button class="btn-print" onclick="window.print()"><i class="fas fa-print"></i> Print Tag</button>
</div>

<div class="tag-wrap">
    <div class="tag-card">
        <div class="tag-brand">ElevateED Donation</div>
        <div class="tag-item-name">@Model.ItemName</div>
        <div class="tag-category">@Model.Category &middot; Qty @Model.Quantity</div>
        <div id="qrcode"></div>
        <div class="tag-code">@Model.TrackingCode</div>
        <div class="tag-instructions">Attach this tag to the item. Scan or enter the code at collection.</div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
    new QRCode(document.getElementById('qrcode'), {
        text: @Html.Raw(Json.Encode(Model.TrackingCode)),
        width: 160,
        height: 160
    });
</script>
