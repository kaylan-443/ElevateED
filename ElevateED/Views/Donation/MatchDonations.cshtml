        color: white;
        padding: 10px 17px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        box-shadow: 0 5px 14px rgba(99,102,241,.18);
    }


    /* =========================================================
       ALERTS
       ========================================================= */

