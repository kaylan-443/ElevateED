@model List<ElevateED.Models.MatchReviewItemViewModel>

@{
    ViewBag.Title = "Match Review";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.ActiveTab = "match";

    var timeWindows = (List<string>)ViewBag.CollectionTimeWindows;

    var matches = Model ?? new List<ElevateED.Models.MatchReviewItemViewModel>();

    var totalMatches = matches.Count;

    var excellentMatches = matches.Count(m => m.MatchScore >= 90);
    var strongMatches = matches.Count(m => m.MatchScore >= 75 && m.MatchScore < 90);
    var reviewMatches = matches.Count(m => m.MatchScore >= 60 && m.MatchScore < 75);
    var lowMatches = matches.Count(m => m.MatchScore < 60);

    var averageScore = totalMatches > 0
        ? matches.Average(m => m.MatchScore)
        : 0;

    var highestScore = totalMatches > 0
        ? matches.Max(m => m.MatchScore)
        : 0;

    var lowestScore = totalMatches > 0
        ? matches.Min(m => m.MatchScore)
        : 0;
}

<style>

    /* =========================================================
       MATCH INTELLIGENCE
       ========================================================= */

    .match-page {
        color: #1f2937;
    }

    .page-header {
        margin-bottom: 22px;
