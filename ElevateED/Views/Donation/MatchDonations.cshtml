@model List<ElevateED.Models.MatchReviewItemViewModel>
@{
    ViewBag.Title = "Match Review";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.ActiveTab = "match";
    var timeWindows = (List<string>)ViewBag.CollectionTimeWindows;
}

<style>
    .page-header { margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
    .page-header h1 { font-size: 24px; font-weight: 700; color: var(--gray-900, #111827); display: flex; align-items: center; gap: 10px; }
    .btn-run-now { background: linear-gradient(135deg, #8b5cf6, #6d28d9); color: white; border: none; padding: 10px 20px; border-radius: 12px; font-weight: 600; font-size: 13px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }

    .match-card { background: white; border: 1px solid var(--gray-200, #e5e7eb); border-radius: 16px; padding: 20px 24px; margin-bottom: 16px; display: flex; gap: 18px; align-items: flex-start; flex-wrap: wrap; }
    .match-photo { width: 64px; height: 64px; border-radius: 12px; object-fit: cover; background: var(--gray-100, #f3f4f6); flex-shrink: 0; }
    .match-photo-placeholder { width: 64px; height: 64px; border-radius: 12px; background: var(--gray-100, #f3f4f6); display: flex; align-items: center; justify-content: center; color: var(--gray-400, #9ca3af); font-size: 20px; flex-shrink: 0; }
    .match-body { flex: 1; min-width: 220px; }
    .match-title { font-weight: 700; font-size: 15px; color: var(--gray-900, #111827); }
    .match-arrow { color: var(--gray-400, #9ca3af); margin: 0 6px; }
    .match-score { display: inline-block; background: #ede9fe; color: #5b21b6; padding: 3px 10px; border-radius: 8px; font-size: 11px; font-weight: 700; margin-top: 6px; }
    .match-reason { font-size: 12px; color: var(--gray-500, #6b7280); margin-top: 6px; }
    .match-actions { display: flex; gap: 8px; flex-shrink: 0; flex-wrap: wrap; }

    .btn-confirm { background: #10b981; color: white; border: none; padding: 9px 16px; border-radius: 10px; font-weight: 600; font-size: 12px; cursor: pointer; }
    .btn-reassign { background: #eef2ff; color: #4338ca; border: none; padding: 9px 16px; border-radius: 10px; font-weight: 600; font-size: 12px; cursor: pointer; }
    .btn-release { background: #fee2e2; color: #991b1b; border: none; padding: 9px 16px; border-radius: 10px; font-weight: 600; font-size: 12px; cursor: pointer; }

    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.5); z-index: 1000; align-items: center; justify-content: center; }
    .modal-overlay.show { display: flex; }
    .modal-box { background: white; border-radius: 18px; padding: 28px; width: 420px; max-width: 90vw; }
    .modal-box h3 { font-size: 17px; font-weight: 700; margin-bottom: 16px; }
    .modal-box label { display: block; font-size: 12px; font-weight: 600; color: var(--gray-600, #4b5563); margin-bottom: 6px; }
    .modal-box input, .modal-box select { width: 100%; padding: 10px 14px; border: 1px solid var(--gray-300, #d1d5db); border-radius: 10px; font-size: 13px; margin-bottom: 14px; font-family: inherit; }
    .modal-actions { display: flex; justify-content: flex-end; gap: 10px; }
    .btn-modal-cancel { background: white; border: 1px solid var(--gray-300, #d1d5db); padding: 10px 18px; border-radius: 10px; font-weight: 600; cursor: pointer; }
    .btn-modal-confirm { border: none; padding: 10px 22px; border-radius: 10px; font-weight: 700; color: white; cursor: pointer; }

    .empty-state { text-align: center; padding: 60px 20px; background: white; border-radius: 16px; border: 1px solid var(--gray-200, #e5e7eb); }
    .empty-state i { font-size: 48px; color: var(--gray-300, #d1d5db); margin-bottom: 15px; }
</style>

@{ Html.RenderPartial("_DonationSubNav"); }

<div class="page-header">
    <h1><i class="fas fa-link" style="color: #8b5cf6;"></i> Match Review</h1>
    <form method="post" action="@Url.Action("RunMatchingNow", "Donation")">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-run-now"><i class="fas fa-sync"></i> Run Matching Now</button>
    </form>
</div>

@if (TempData["Success"] != null)
{
    <div style="background:#d1fae5;color:#065f46;padding:14px 18px;border-radius:12px;margin-bottom:20px;font-size:13px;"><i class="fas fa-check-circle"></i> @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div style="background:#fee2e2;color:#991b1b;padding:14px 18px;border-radius:12px;margin-bottom:20px;font-size:13px;"><i class="fas fa-exclamation-circle"></i> @TempData["Error"]</div>
}

@if (Model == null || !Model.Any())
{
    <div class="empty-state">
        <i class="fas fa-link"></i>
        <h4>No proposed matches right now</h4>
        <p style="color:var(--gray-500,#6b7280);">Run matching, or wait for the next scheduled sweep.</p>
    </div>
}
else
{
    foreach (var m in Model)
    {
        <div class="match-card">
            @if (!string.IsNullOrEmpty(m.ItemPhoto))
            {
                <img src="@m.ItemPhoto" class="match-photo" />
            }
            else
            {
                <div class="match-photo-placeholder"><i class="fas fa-box"></i></div>
            }
            <div class="match-body">
                <div class="match-title">@m.ItemName <span class="match-arrow"><i class="fas fa-arrow-right"></i></span> @m.StudentName</div>
                <div style="font-size:12px;color:var(--gray-500,#6b7280);">@m.Category &middot; Proposed @m.ProposedDate.ToString("dd MMM yyyy")</div>
                <span class="match-score"><i class="fas fa-star"></i> Match score: @m.MatchScore</span>
                <div class="match-reason">@m.MatchReason</div>
            </div>
            <div class="match-actions">
                <button class="btn-confirm" onclick="openConfirmModal(@m.AllocationId, '@Html.Raw(m.ItemName.Replace("'", "\\'"))', '@Html.Raw((m.StudentName ?? "").Replace("'", "\\'"))')"><i class="fas fa-check"></i> Confirm</button>
                <button class="btn-reassign" onclick="openReassignModal(@m.AllocationId)"><i class="fas fa-random"></i> Reassign</button>
                <button class="btn-release" onclick="releaseMatch(@m.AllocationId)"><i class="fas fa-undo"></i> Release</button>
            </div>
        </div>
    }
}

<!-- Confirm & Schedule Modal -->
<div class="modal-overlay" id="confirmModal">
    <div class="modal-box">
        <h3><i class="fas fa-calendar-check"></i> Confirm Match & Schedule Collection</h3>
        <form method="post" action="@Url.Action("ConfirmMatch", "Donation")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="allocationId" id="confirmAllocId" />
            <label><span id="confirmSummary"></span></label>
            <label>Collection Date</label>
            <input type="date" name="collectionDate" required />
            <label>Collection Time Window</label>
            <select name="timeWindow" required>
                @foreach (var w in timeWindows)
                {
                    <option value="@w">@w</option>
                }
            </select>
            <div class="modal-actions">
                <button type="button" class="btn-modal-cancel" onclick="closeModals()">Cancel</button>
                <button type="submit" class="btn-modal-confirm" style="background:#10b981;">Confirm & Notify Learner</button>
            </div>
        </form>
    </div>
</div>

<!-- Reassign Modal -->
<div class="modal-overlay" id="reassignModal">
    <div class="modal-box">
        <h3><i class="fas fa-random"></i> Reassign to a Different Request</h3>
        <form method="post" action="@Url.Action("ReassignMatch", "Donation")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="allocationId" id="reassignAllocId" />
            <label>Choose a different waitlisted request in the same category</label>
            <select name="newRequestItemId" id="reassignOptions" required></select>
            <div class="modal-actions">
                <button type="button" class="btn-modal-cancel" onclick="closeModals()">Cancel</button>
                <button type="submit" class="btn-modal-confirm" style="background:#4338ca;">Reassign</button>
            </div>
        </form>
    </div>
</div>

<script>
    function closeModals() {
        document.getElementById('confirmModal').classList.remove('show');
        document.getElementById('reassignModal').classList.remove('show');
    }

    function openConfirmModal(allocationId, itemName, studentName) {
        document.getElementById('confirmAllocId').value = allocationId;
        document.getElementById('confirmSummary').textContent = itemName + ' \u2192 ' + studentName;
        document.getElementById('confirmModal').classList.add('show');
    }

    function openReassignModal(allocationId) {
        document.getElementById('reassignAllocId').value = allocationId;
        var select = document.getElementById('reassignOptions');
        select.innerHTML = '<option>Loading...</option>';
        fetch('@Url.Action("GetAlternativeRequests", "Donation")?allocationId=' + allocationId)
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (!data.length) { select.innerHTML = '<option value="">No other waitlisted requests in this category</option>'; return; }
                select.innerHTML = '';
                data.forEach(function (d) {
                    var opt = document.createElement('option');
                    opt.value = d.Id;
                    opt.textContent = d.StudentName + ' (Priority Score: ' + d.PriorityScore + ')';
                    select.appendChild(opt);
                });
            });
        document.getElementById('reassignModal').classList.add('show');
    }

    function releaseMatch(allocationId) {
        if (!confirm('Release this match back to the Available pool?')) return;
        var form = document.createElement('form');
        form.method = 'post';
        form.action = '@Url.Action("ReleaseMatch", "Donation")';
        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        form.innerHTML = '<input type="hidden" name="allocationId" value="' + allocationId + '" />' +
                          '<input type="hidden" name="__RequestVerificationToken" value="' + token + '" />';
        document.body.appendChild(form);
        form.submit();
    }
</script>
