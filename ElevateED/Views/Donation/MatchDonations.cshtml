    }

    .preview-decline .preview-item-value {
        color: #dc2626;
    }

    .automation-actions {
        margin-top: 16px;
        display: flex;
        justify-content: flex-end;
        gap: 9px;
        flex-wrap: wrap;
    }

    .btn-preview {
        border: 1px solid #c7d2fe;
        background: white;
        color: #4338ca;
        padding: 10px 15px;
        border-radius: 10px;
        font-size: 12px;
