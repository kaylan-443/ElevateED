                        </button>

                    </div>

                    <div class="ai-footer-buttons">

                        <button type="button"
                                id="aiReplay"
                                class="ai-replay">

                            <i class="fas fa-redo"></i>
                            Replay Briefing

                        </button>

                    </div>

                </div>

            </div>

        </div>


        <!-- FLOATING BUTTON -->

        <button type="button"
                id="aiFloatingButton"
                class="ai-floating-button"
                aria-label="Open Elevate AI">

            <div class="ai-notification-ring"></div>

            <div class="ai-floating-inner">

                <span class="ai-floating-symbol">
                    ✦
                </span>

                <span class="ai-floating-text">
                    ELEVATE AI
                </span>

            </div>

        </button>
    }


    @if (isAdmin)
    {
        <script>

    /* =========================================================
       ELEVATE AI DATA
       ========================================================= */

    var elevateAIData = {

        pendingApprovals: @Model.PendingApprovals,

        intakeToday: @Model.AwaitingIntakeToday,

        availableItems: @Model.AvailableItems,

        pendingMatches: @Model.PendingMatchReview,

        awaitingCollection: @Model.AwaitingCollectionTotal,

        waitlistedRequests: @Model.WaitlistedRequests,

        personName:
            "@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.PersonName ?? "Admin"))"

    };


    /* =========================================================
       ELEMENTS
       ========================================================= */

    var aiWindow =
        document.getElementById("elevateAI");

    var aiFloatingButton =
        document.getElementById("aiFloatingButton");

    var aiClose =
        document.getElementById("aiClose");

    var aiReplay =
        document.getElementById("aiReplay");

    var aiPrevious =
        document.getElementById("aiPrevious");

    var aiNext =
        document.getElementById("aiNext");

    var aiThinking =
        document.getElementById("aiThinking");

    var aiThinkingText =
        document.getElementById("aiThinkingText");

    var aiMessage =
        document.getElementById("aiMessage");

    var aiMessageText =
        document.getElementById("aiMessageText");

    var aiMessageLabel =
        document.getElementById("aiMessageLabel");

    var aiProgressBar =
        document.getElementById("aiProgressBar");

    var aiCounter =
        document.getElementById("aiCounter");

    var aiAction =
        document.getElementById("aiAction");


    if (
        !aiWindow ||
        !aiFloatingButton ||
        !aiClose ||
        !aiReplay ||
        !aiPrevious ||
        !aiNext ||
        !aiThinking ||
        !aiThinkingText ||
        !aiMessage ||
        !aiMessageText ||
        !aiMessageLabel ||
        !aiProgressBar ||
        !aiCounter ||
        !aiAction
    ) {
        console.error("ELEVATE AI: One or more assistant elements are missing.");
    }
    else {


    /* =========================================================
       STATE
       ========================================================= */

    var aiFacts = [];

    var aiCurrentIndex = 0;

    var aiIsThinking = false;


    /* =========================================================
       BUILD BRIEFING
       ========================================================= */

    function buildBriefing() {

        var facts = [];


        /* -----------------------------------------------------
           INTRO
           ----------------------------------------------------- */

        facts.push({

            type: "info",

            label: "ELEVATE AI",

            text:
                "I've completed my scan of the donation operation. " +
                "I'll take you through the current situation one item at a time.",

            action: null,

            url: null

        });


        /* -----------------------------------------------------
           APPROVALS
           ----------------------------------------------------- */

        if (elevateAIData.pendingApprovals > 0) {

            facts.push({

                type: "attention",

                label: "ATTENTION REQUIRED",

                text:
                    "You currently have " +
                    elevateAIData.pendingApprovals +
                    " donation" +
                    (elevateAIData.pendingApprovals === 1 ? "" : "s") +
                    " waiting for approval.",

                action: "Review Pending Donations",

                url: "@Url.Action("ApproveDonation", "Donation")"

            });

        }
        else {

            facts.push({

                type: "good",

                label: "APPROVAL PIPELINE",

                text:
                    "There are no donations currently waiting for approval. " +
                    "Your approval queue is clear.",

                action: null,

                url: null

            });

        }


        /* -----------------------------------------------------
           INTAKE
           ----------------------------------------------------- */

        if (elevateAIData.intakeToday > 0) {

            facts.push({

                type: "info",

                label: "TODAY'S OPERATIONS",

                text:
                    "There are " +
                    elevateAIData.intakeToday +
                    " intake booking" +
                    (elevateAIData.intakeToday === 1 ? "" : "s") +
                    " scheduled for today.",

                action: "Review Donations",

                url: "@Url.Action("ApproveDonation", "Donation")"

            });

        }
        else {

            facts.push({

                type: "good",

                label: "TODAY'S OPERATIONS",

                text:
                    "There are no donation intake bookings scheduled for today.",

                action: null,

                url: null

            });

        }


        /* -----------------------------------------------------
           INVENTORY
           ----------------------------------------------------- */

        if (elevateAIData.availableItems > 0) {

            facts.push({

                type: "info",

                label: "INVENTORY STATUS",

                text:
                    "The donation pool currently has " +
                    elevateAIData.availableItems +
                    " available item" +
                    (elevateAIData.availableItems === 1 ? "" : "s") +
                    " ready for allocation.",

                action: "View Insights",

                url: "@Url.Action("Insights", "Donation")"

            });

        }
        else {

            facts.push({

                type: "attention",

                label: "INVENTORY ALERT",

                text:
                    "The available donation inventory is currently empty. " +
                    "You may want to monitor incoming donations closely.",

                action: "View Insights",

                url: "@Url.Action("Insights", "Donation")"

            });

        }


        /* -----------------------------------------------------
           MATCHES
           ----------------------------------------------------- */

        if (elevateAIData.pendingMatches > 0) {

            facts.push({

                type: "attention",

                label: "MATCH REVIEW",

                text:
                    "There are " +
                    elevateAIData.pendingMatches +
                    " proposed donation match" +
                    (elevateAIData.pendingMatches === 1 ? "" : "es") +
                    " waiting for your review.",

                action: "Review Matches",

                url: "@Url.Action("MatchDonations", "Donation")"

            });

        }
        else {

            facts.push({

                type: "good",

                label: "MATCHING ENGINE",

                text:
                    "There are currently no proposed matches waiting for review.",

                action: null,

                url: null

            });

        }


        /* -----------------------------------------------------
           COLLECTION
           ----------------------------------------------------- */

        if (elevateAIData.awaitingCollection > 0) {

            facts.push({

                type: "info",

                label: "COLLECTION STATUS",

                text:
                    elevateAIData.awaitingCollection +
                    " donation" +
                    (elevateAIData.awaitingCollection === 1 ? "" : "s") +
                    " are currently awaiting collection.",

                action: "Process Collection",

                url: "@Url.Action("ProcessCollection", "Donation")"

            });

        }


        /* -----------------------------------------------------
           WAITLIST
           ----------------------------------------------------- */

        if (elevateAIData.waitlistedRequests > 0) {

            facts.push({

                type: "attention",

                label: "DEMAND ALERT",

                text:
                    "There are currently " +
                    elevateAIData.waitlistedRequests +
                    " learner request" +
                    (elevateAIData.waitlistedRequests === 1 ? "" : "s") +
                    " on the waitlist.",

                action: "View Insights",

                url: "@Url.Action("Insights", "Donation")"

            });

        }
        else {

            facts.push({

                type: "good",

                label: "REQUEST QUEUE",

                text:
                    "There are currently no learners waiting on the donation request queue.",

                action: null,

                url: null

            });

        }


        /* -----------------------------------------------------
           RECOMMENDATION
           ----------------------------------------------------- */

        if (elevateAIData.pendingApprovals > 0) {

            facts.push({

                type: "recommendation",

                label: "MY RECOMMENDATION",

                text:
                    "I recommend starting with the pending approvals. " +
                    "Clearing that queue will keep the donation pipeline moving.",

                action: "Open Approval Queue",

                url: "@Url.Action("ApproveDonation", "Donation")"

            });

        }
        else if (elevateAIData.pendingMatches > 0) {

            facts.push({

                type: "recommendation",

                label: "MY RECOMMENDATION",

                text:
                    "Your approval queue is clear. " +
                    "I recommend reviewing the proposed matches next.",

                action: "Review Matches",

                url: "@Url.Action("MatchDonations", "Donation")"

            });

        }
        else if (elevateAIData.waitlistedRequests > 0) {

            facts.push({

                type: "recommendation",

                label: "MY RECOMMENDATION",

                text:
                    "The main area needing attention is learner demand. " +
                    "I recommend checking the donation insights and waitlist.",

                action: "View Insights",

                url: "@Url.Action("Insights", "Donation")"

            });

        }
        else {

            facts.push({

                type: "recommendation",

                label: "SYSTEM STATUS",

                text:
                    "The donation operation currently looks stable. " +
                    "No immediate action is required from the dashboard.",

                action: "View Insights",

                url: "@Url.Action("Insights", "Donation")"

            });

        }


        return facts;
    }


    /* =========================================================
       SHOW MESSAGE
       ========================================================= */

    function showMessage(index, thinking) {

        if (!aiFacts || aiFacts.length === 0)
            return;


        if (index < 0)
            index = 0;

        if (index >= aiFacts.length)
            index = aiFacts.length - 1;


        aiCurrentIndex = index;

        var fact = aiFacts[aiCurrentIndex];


        /* -----------------------------------------------------
           THINKING ANIMATION
           ----------------------------------------------------- */

        if (thinking) {

            aiIsThinking = true;

            aiThinking.style.display = "flex";

            aiThinkingText.innerHTML =
                "PROCESSING UPDATE";

            aiMessage.classList.add("transitioning");

            aiNext.disabled = true;

            aiPrevious.disabled = true;


            setTimeout(function () {

                renderFact(fact);

            }, 650);

        }
        else {

            renderFact(fact);

        }

    }


    /* =========================================================
       RENDER MESSAGE
       ========================================================= */

    function renderFact(fact) {

        aiIsThinking = false;

        aiThinking.style.display = "none";

        aiMessage.classList.remove("transitioning");


        /* -----------------------------------------------------
           MESSAGE TYPE
           ----------------------------------------------------- */

        aiMessage.className =
            "ai-message " +
            (
                fact.type === "attention"
                    ? "attention"
                    : fact.type === "good"
                        ? "good"
                        : fact.type === "recommendation"
                            ? "recommendation"
                            : "info"
            );


        /* -----------------------------------------------------
           TEXT
           ----------------------------------------------------- */

        aiMessageLabel.innerHTML =
            fact.label;

        aiMessageText.classList.remove("appear");

        aiMessageText.innerHTML =
            fact.text;

        void aiMessageText.offsetWidth;

        aiMessageText.classList.add("appear");


        /* -----------------------------------------------------
           COUNTER
           ----------------------------------------------------- */

        aiCounter.innerHTML =
            (aiCurrentIndex + 1) +
            " / " +
            aiFacts.length;


        /* -----------------------------------------------------
           PROGRESS
           ----------------------------------------------------- */

        var progress =
            ((aiCurrentIndex + 1) / aiFacts.length) * 100;

        aiProgressBar.style.width =
            progress + "%";


        /* -----------------------------------------------------
           ACTION
           ----------------------------------------------------- */

        if (fact.action && fact.url) {

            aiAction.style.display = "block";

            aiAction.href =
                fact.url;

            aiAction.innerHTML =
                fact.action +
                ' <i class="fas fa-arrow-right"></i>';

        }
        else {

            aiAction.style.display = "none";

        }


        /* -----------------------------------------------------
           NAVIGATION
           ----------------------------------------------------- */

        aiPrevious.disabled =
            aiCurrentIndex === 0;

        aiNext.disabled =
            aiCurrentIndex === aiFacts.length - 1;


        /* -----------------------------------------------------
           NEXT BUTTON TEXT
           ----------------------------------------------------- */

        if (aiCurrentIndex === aiFacts.length - 1) {

            aiNext.innerHTML =
                'Finish <i class="fas fa-check"></i>';

        }
        else {

            aiNext.innerHTML =
                'Next <i class="fas fa-arrow-right"></i>';

        }


        /*
         * Re-enable navigation
         */

        aiNext.disabled =
            aiCurrentIndex === aiFacts.length - 1;

        aiPrevious.disabled =
            aiCurrentIndex === 0;

    }


    /* =========================================================
       START BRIEFING
       ========================================================= */

    function startBriefing() {

        aiFacts =
            buildBriefing();

        aiCurrentIndex = 0;

        aiFloatingButton.classList.remove("active");

        aiWindow.classList.remove("hidden");

        aiAction.style.display = "none";

        aiProgressBar.style.width = "0%";

        aiCounter.innerHTML =
            "1 / " + aiFacts.length;


        /*
         * Initial AI thinking
         */

        aiThinking.style.display = "flex";

        aiThinkingText.innerHTML =
            "ANALYSING OPERATIONS";

        aiMessageText.innerHTML =
            "Scanning the donation operation...";

        aiMessageLabel.innerHTML =
            "ELEVATE AI";


        aiPrevious.disabled = true;

        aiNext.disabled = true;


        setTimeout(function () {

            showMessage(0, false);

        }, 1100);

    }


    /* =========================================================
       NEXT
       ========================================================= */

    function nextMessage() {

        if (aiIsThinking)
            return;

        if (aiCurrentIndex >= aiFacts.length - 1)
            return;

        showMessage(
            aiCurrentIndex + 1,
            true
        );

    }


    /* =========================================================
       PREVIOUS
       ========================================================= */

    function previousMessage() {

        if (aiIsThinking)
            return;

        if (aiCurrentIndex <= 0)
            return;

        showMessage(
            aiCurrentIndex - 1,
            true
        );

    }


    /* =========================================================
       CLOSE
       ========================================================= */

    function closeAssistant() {

        aiWindow.classList.add("hidden");

        aiFloatingButton.classList.add("active");

    }


    /* =========================================================
       OPEN
       ========================================================= */

    function openAssistant() {

        aiFloatingButton.classList.remove("active");

        aiWindow.classList.remove("hidden");

        /*
         * If the briefing hasn't been loaded,
         * start it.
         */

        if (!aiFacts.length) {

            startBriefing();

        }

    }


    /* =========================================================
       BUTTON EVENTS
       ========================================================= */

    aiNext.addEventListener("click", function () {

        nextMessage();

    });


    aiPrevious.addEventListener("click", function () {

        previousMessage();

    });


    aiClose.addEventListener("click", function () {

        closeAssistant();

    });


    aiFloatingButton.addEventListener("click", function () {

        openAssistant();

    });


    aiReplay.addEventListener("click", function () {

        startBriefing();

    });


    /* =========================================================
       KEYBOARD CONTROLS
       ========================================================= */

    document.addEventListener("keydown", function (event) {

        /*
         * Don't interfere with typing into inputs.
         */

        var tag =
            document.activeElement
                ? document.activeElement.tagName
                : "";

        if (
            tag === "INPUT" ||
            tag === "TEXTAREA" ||
            tag === "SELECT"
        ) {
            return;
        }


        if (event.key === "ArrowRight") {

            nextMessage();

        }


        if (event.key === "ArrowLeft") {

            previousMessage();

        }

    });


    /* =========================================================
       AUTOMATIC START
       ========================================================= */

    document.addEventListener("DOMContentLoaded", function () {

        setTimeout(function () {

            startBriefing();

        }, 900);

    });

    }

        </script>
    }
