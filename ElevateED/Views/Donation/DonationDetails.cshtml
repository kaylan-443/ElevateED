@model ElevateED.Models.DonationItem
@using ElevateED.Models
@{
    ViewBag.Title = "Donation Details";
    Layout = (User.IsInRole("Admin") || User.IsInRole("Principal")) ? "~/Views/Shared/_AdminLayout.cshtml"
           : User.IsInRole("Teacher") ? "~/Views/Shared/_TeacherLayout.cshtml"
           : "~/Views/Shared/_StudentLayout.cshtml";
    ViewBag.ActivePage = "donations";
    var history = (List<DonationHistory>)ViewBag.History;
    var allocation = ViewBag.Allocation as DonationAllocation;
}

<style>
    .page-header { margin-bottom: 20px; }
    .page-header h1 { font-size: 24px; font-weight: 700; color: var(--gray-900, #111827); display: flex; align-items: center; gap: 10px; }

    .details-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    @@media (max-width: 900px) { .details-grid { grid-template-columns: 1fr; } }

    .panel { background: white; border-radius: 16px; border: 1px solid var(--gray-200, #e5e7eb); padding: 24px; margin-bottom: 24px; }
    .panel-title { font-size: 15px; font-weight: 700; color: var(--gray-900, #111827); margin-bottom: 16px; }

    .item-photo { width: 100%; max-height: 220px; object-fit: cover; border-radius: 12px; margin-bottom: 16px; }
    .detail-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--gray-100, #f3f4f6); font-size: 13px; }
    .detail-row:last-child { border-bottom: none; }
    .detail-label { color: var(--gray-500, #6b7280); }
    .detail-value { color: var(--gray-900, #111827); font-weight: 600; }

    .badge { padding: 4px 12px; border-radius: 10px; font-size: 11px; font-weight: 700; background: #eef2ff; color: #4338ca; }

    .timeline-item { display: flex; gap: 12px; padding: 12px 0; border-left: 2px solid var(--gray-200, #e5e7eb); padding-left: 16px; margin-left: 6px; position: relative; }
    .timeline-item::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--primary, #4f46e5); position: absolute; left: -6px; top: 14px; }
    .timeline-action { font-weight: 700; font-size: 13px; color: var(--gray-900, #111827); }
    .timeline-desc { font-size: 12px; color: var(--gray-600, #4b5563); margin-top: 2px; }
    .timeline-date { font-size: 11px; color: var(--gray-400, #9ca3af); margin-top: 2px; }
</style>

<div class="page-header">
    <h1><i class="fas fa-box" style="color: var(--primary, #4f46e5);"></i> @Model.ItemName</h1>
</div>

<div class="details-grid">
    <div class="panel">
        <div class="panel-title">Item Details</div>
        @if (!string.IsNullOrEmpty(Model.PhotoEvidence))
        {
            <img src="@Model.PhotoEvidence" class="item-photo" />
        }
        <div class="detail-row"><span class="detail-label">Category</span><span class="detail-value">@Model.Category</span></div>
        <div class="detail-row"><span class="detail-label">Status</span><span class="badge">@Model.Status</span></div>
        <div class="detail-row"><span class="detail-label">Donor</span><span class="detail-value">@Model.DonorName (@Model.DonorType)</span></div>
        <div class="detail-row"><span class="detail-label">Quantity</span><span class="detail-value">@Model.Quantity</span></div>
        <div class="detail-row"><span class="detail-label">Condition</span><span class="detail-value">@Model.Condition</span></div>
        <div class="detail-row"><span class="detail-label">Tracking Code</span><span class="detail-value" style="font-family:monospace;">@Model.TrackingCode</span></div>
        <div class="detail-row"><span class="detail-label">Submitted</span><span class="detail-value">@Model.DonationDate.ToString("dd MMM yyyy")</span></div>
        @if (Model.ScheduledIntakeDate.HasValue)
        {
            <div class="detail-row"><span class="detail-label">Intake Date</span><span class="detail-value">@Model.ScheduledIntakeDate.Value.ToString("dd MMM yyyy")</span></div>
        }
        @if (!string.IsNullOrEmpty(Model.RejectionReason))
        {
            <div class="detail-row"><span class="detail-label">Rejection Reason</span><span class="detail-value">@Model.RejectionReason</span></div>
        }

        @if (allocation != null)
        {
            <div class="panel-title" style="margin-top:20px;">Allocation</div>
            <div class="detail-row"><span class="detail-label">Matched To</span><span class="detail-value">@(allocation.Student != null ? allocation.Student.FullName : "\u2014")</span></div>
            <div class="detail-row"><span class="detail-label">Status</span><span class="badge">@allocation.Status</span></div>
            if (!string.IsNullOrEmpty(allocation.MatchReason))
            {
                <div class="detail-row"><span class="detail-label">Match Reason</span><span class="detail-value">@allocation.MatchReason</span></div>
            }
           if (allocation.ScheduledCollectionDate.HasValue)
            {
                <div class="detail-row"><span class="detail-label">Collection Date</span><span class="detail-value">@allocation.ScheduledCollectionDate.Value.ToString("dd MMM yyyy")</span></div>
            }
        }
    </div>

    <div class="panel">
        <div class="panel-title">Timeline</div>
        @if (history != null && history.Any())
        {
            foreach (var h in history)
            {
                <div class="timeline-item">
                    <div>
                        <div class="timeline-action">@h.Action</div>
                        <div class="timeline-desc">@h.Description</div>
                        <div class="timeline-date">@h.ActionDate.ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                </div>
            }
        }
        else
        {
            <p style="color:var(--gray-400,#9ca3af); font-size:13px;">No history recorded yet.</p>
        }
    </div>
</div>
