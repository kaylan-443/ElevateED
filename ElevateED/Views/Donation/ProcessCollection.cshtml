@{
    ViewBag.Title = "Process Collection";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.ActiveTab = "collect";
}

<style>
    .page-header { margin-bottom: 20px; }
    .page-header h1 { font-size: 24px; font-weight: 700; color: var(--gray-900, #111827); display: flex; align-items: center; gap: 10px; }

    .step-panel { background: white; border: 1px solid var(--gray-200, #e5e7eb); border-radius: 16px; padding: 24px; margin-bottom: 20px; }
    .step-panel.disabled { opacity: 0.5; pointer-events: none; }
    .step-title { font-size: 15px; font-weight: 700; color: var(--gray-900, #111827); margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }

    .search-row { display: flex; gap: 10px; }
    .search-row input { flex: 1; padding: 12px 16px; border: 1px solid var(--gray-300, #d1d5db); border-radius: 12px; font-size: 14px; font-family: monospace; }
    .btn-search { background: var(--primary, #4f46e5); color: white; border: none; padding: 12px 24px; border-radius: 12px; font-weight: 600; cursor: pointer; }

    .lookup-result { display: flex; gap: 16px; margin-top: 18px; padding: 16px; background: var(--gray-50, #f9fafb); border-radius: 12px; align-items: center; flex-wrap: wrap; }
    .lookup-photo { width: 64px; height: 64px; border-radius: 12px; object-fit: cover; background: var(--gray-200, #e5e7eb); flex-shrink: 0; }
    .lookup-photo-placeholder { width: 64px; height: 64px; border-radius: 12px; background: var(--gray-200, #e5e7eb); display: flex; align-items: center; justify-content: center; color: var(--gray-400, #9ca3af); font-size: 20px; flex-shrink: 0; }
    .lookup-body { flex: 1; min-width: 200px; }
    .lookup-title { font-weight: 700; font-size: 14px; color: var(--gray-900, #111827); }
    .lookup-meta { font-size: 12px; color: var(--gray-500, #6b7280); margin-top: 2px; }

    .scan-row { display: flex; gap: 16px; align-items: flex-start; flex-wrap: wrap; margin-top: 10px; }
    #scanVideo { width: 260px; height: 195px; background: #000; border-radius: 12px; object-fit: cover; }
    .manual-entry { flex: 1; min-width: 220px; }
    .manual-entry input { width: 100%; padding: 12px 16px; border: 1px solid var(--gray-300, #d1d5db); border-radius: 12px; font-size: 13px; font-family: monospace; margin-bottom: 10px; }
    .btn-verify { background: #8b5cf6; color: white; border: none; padding: 10px 20px; border-radius: 10px; font-weight: 600; cursor: pointer; }
    .btn-camera { background: var(--gray-100, #f3f4f6); color: var(--gray-700, #374151); border: none; padding: 10px 16px; border-radius: 10px; font-weight: 600; cursor: pointer; margin-bottom: 10px; }

    .verify-ok { background: #d1fae5; color: #065f46; padding: 12px 16px; border-radius: 10px; margin-top: 12px; font-size: 13px; }
    .verify-fail { background: #fee2e2; color: #991b1b; padding: 12px 16px; border-radius: 10px; margin-top: 12px; font-size: 13px; }

    .btn-confirm-collection { background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; padding: 14px 32px; border-radius: 12px; font-weight: 700; font-size: 14px; cursor: pointer; margin-top: 16px; }
</style>

@{ Html.RenderPartial("_DonationSubNav"); }

<div class="page-header">
    <h1><i class="fas fa-qrcode" style="color: #3b82f6;"></i> Process Collection</h1>
</div>

<div class="step-panel">
    <div class="step-title"><i class="fas fa-search"></i> Step 1 &mdash; Look up the Collection Code</div>
    <div class="search-row">
        <input type="text" id="codeInput" placeholder="Enter Collection Code (e.g. COL-A1B2C3D4)" />
        <button class="btn-search" onclick="lookupCode()"><i class="fas fa-search"></i> Look Up</button>
    </div>
    <div id="lookupResultBox"></div>
</div>

<div class="step-panel disabled" id="scanPanel">
    <div class="step-title"><i class="fas fa-qrcode"></i> Step 2 &mdash; Scan or Enter the Item's QR Tag</div>
    <div class="scan-row">
        <div>
            <button class="btn-camera" onclick="startCamera()"><i class="fas fa-camera"></i> Start Camera</button>
            <video id="scanVideo" autoplay playsinline style="display:none;"></video>
            <canvas id="scanCanvas" style="display:none;"></canvas>
        </div>
        <div class="manual-entry">
            <label style="font-size:12px;font-weight:600;color:var(--gray-600,#4b5563);">Or type the tag code manually</label>
            <input type="text" id="manualCode" placeholder="DON-20261002-XXXXXXXX" />
            <button class="btn-verify" onclick="verifyTag(manualCodeValue())"><i class="fas fa-check"></i> Verify Tag</button>
        </div>
    </div>
    <div id="verifyResultBox"></div>
</div>

<div class="step-panel disabled" id="confirmPanel">
    <div class="step-title"><i class="fas fa-handshake"></i> Step 3 &mdash; Confirm Hand-Over</div>
    <p style="font-size:13px;color:var(--gray-600,#4b5563);">The scanned tag matches this allocation. Confirm once the item has been physically handed to the learner.</p>
    <button class="btn-confirm-collection" onclick="confirmCollection()"><i class="fas fa-check-double"></i> Confirm Collection</button>
    <div id="confirmResultBox"></div>
</div>

<script>
    var currentAllocationId = null;
    var videoStream = null;
    var scanInterval = null;

    function manualCodeValue() { return document.getElementById('manualCode').value.trim(); }

    function lookupCode() {
        var code = document.getElementById('codeInput').value.trim();
        if (!code) return;
        fetch('@Url.Action("LookupCollectionCode", "Donation")?code=' + encodeURIComponent(code))
            .then(function (r) { return r.json(); })
            .then(function (data) {
                var box = document.getElementById('lookupResultBox');
                if (!data.Found) {
                    box.innerHTML = '<div class="verify-fail"><i class="fas fa-exclamation-circle"></i> ' + data.Message + '</div>';
                    document.getElementById('scanPanel').classList.add('disabled');
                    document.getElementById('confirmPanel').classList.add('disabled');
                    currentAllocationId = null;
                    return;
                }
                currentAllocationId = data.AllocationId;
                var photoHtml = data.ItemPhoto
                    ? '<img src="' + data.ItemPhoto + '" class="lookup-photo" />'
                    : '<div class="lookup-photo-placeholder"><i class="fas fa-box"></i></div>';
                box.innerHTML = '<div class="lookup-result">' + photoHtml +
                    '<div class="lookup-body"><div class="lookup-title">' + data.ItemName + '</div>' +
                    '<div class="lookup-meta">For: ' + data.StudentName + ' \u00b7 Qty ' + data.Quantity + ' \u00b7 Condition: ' + data.Condition + '</div></div></div>';
                document.getElementById('scanPanel').classList.remove('disabled');
                document.getElementById('confirmPanel').classList.add('disabled');
                document.getElementById('verifyResultBox').innerHTML = '';
            });
    }

    function startCamera() {
        var video = document.getElementById('scanVideo');
        navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } }).then(function (stream) {
            videoStream = stream;
            video.srcObject = stream;
            video.style.display = 'block';
            scanInterval = setInterval(scanFrame, 400);
        }).catch(function () {
            alert('Could not access the camera \u2014 use manual entry instead.');
        });
    }

    function scanFrame() {
        var video = document.getElementById('scanVideo');
        var canvas = document.getElementById('scanCanvas');
        if (video.readyState !== video.HAVE_ENOUGH_DATA) return;
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;
        var ctx = canvas.getContext('2d');
        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
        var imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        var code = window.jsQR ? jsQR(imageData.data, imageData.width, imageData.height) : null;
        if (code && code.data) {
            stopCamera();
            verifyTag(code.data);
        }
    }

    function stopCamera() {
        if (scanInterval) clearInterval(scanInterval);
        if (videoStream) videoStream.getTracks().forEach(function (t) { t.stop(); });
        document.getElementById('scanVideo').style.display = 'none';
    }

    function verifyTag(scannedCode) {
        if (!currentAllocationId || !scannedCode) return;
        fetch('@Url.Action("VerifyItemTag", "Donation")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({ allocationId: currentAllocationId, scannedCode: scannedCode })
        }).then(function (r) { return r.json(); }).then(function (data) {
            var box = document.getElementById('verifyResultBox');
            if (data.success) {
                box.innerHTML = '<div class="verify-ok"><i class="fas fa-check-circle"></i> Tag verified \u2014 ' + data.itemName + ' for ' + data.studentName + '</div>';
                document.getElementById('confirmPanel').classList.remove('disabled');
            } else {
                box.innerHTML = '<div class="verify-fail"><i class="fas fa-exclamation-triangle"></i> ' + data.message + '</div>';
                document.getElementById('confirmPanel').classList.add('disabled');
            }
        });
    }

    function confirmCollection() {
        if (!currentAllocationId) return;
        fetch('@Url.Action("ConfirmCollection", "Donation")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({ allocationId: currentAllocationId })
        }).then(function (r) { return r.json(); }).then(function (data) {
            var box = document.getElementById('confirmResultBox');
            if (data.success) {
                box.innerHTML = '<div class="verify-ok"><i class="fas fa-check-double"></i> ' + data.message + '</div>';
                setTimeout(function () { window.location.reload(); }, 1800);
            } else {
                box.innerHTML = '<div class="verify-fail">' + data.message + '</div>';
            }
        });
    }
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jsQR/1.4.0/jsQR.js"></script>
