@model List<ElevateED.Models.DonationRequest>
@using ElevateED.Models
@{
    ViewBag.Title = "My Requests";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewBag.ActivePage = "donations";
    ViewBag.ActiveTab = "myrequests";
    var queuePositions = (Dictionary<int, int>)ViewBag.QueuePositions;
}

<style>
    .page-header { margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
    .page-header h1 { font-size: 24px; font-weight: 700; color: var(--gray-900, #111827); display: flex; align-items: center; gap: 10px; }
    .btn-primary-pill { background: var(--primary, #4f46e5); color: white; padding: 10px 20px; border-radius: 12px; text-decoration: none; font-weight: 600; font-size: 13px; display: inline-flex; align-items: center; gap: 8px; }

    .request-card { background: white; border: 1px solid var(--gray-200, #e5e7eb); border-radius: 16px; padding: 20px 24px; margin-bottom: 16px; }
    .request-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 8px; }
    .request-ref { font-weight: 700; color: var(--gray-900, #111827); font-size: 14px; }
    .request-date { font-size: 12px; color: var(--gray-400, #9ca3af); }

    .req-item-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-top: 1px solid var(--gray-100, #f3f4f6); flex-wrap: wrap; gap: 8px; }
    .req-item-name { font-size: 13px; font-weight: 600; color: var(--gray-800, #1f2937); }
    .req-item-meta { font-size: 12px; color: var(--gray-500, #6b7280); }

    .badge { padding: 4px 12px; border-radius: 10px; font-size: 11px; font-weight: 700; }
    .badge-waitlisted { background: #fef3c7; color: #92400e; }
    .badge-reserved { background: #e0e7ff; color: #3730a3; }
    .badge-awaitingcollection { background: #dbeafe; color: #1e40af; }
    .badge-fulfilled { background: #d1fae5; color: #065f46; }
    .badge-declined { background: #fee2e2; color: #991b1b; }

    .queue-pos { font-size: 11px; color: var(--primary, #4f46e5); font-weight: 700; }

    .btn-cancel-item { background: #fee2e2; color: #991b1b; border: none; border-radius: 8px; padding: 5px 12px; font-size: 11px; font-weight: 600; cursor: pointer; }
    .btn-cancel-item:hover { background: #fecaca; }

    .empty-state { text-align: center; padding: 60px 20px; background: white; border-radius: 16px; border: 1px solid var(--gray-200, #e5e7eb); }
    .empty-state i { font-size: 48px; color: var(--gray-300, #d1d5db); margin-bottom: 15px; }
</style>

@{ Html.RenderPartial("_DonationSubNav"); }

<div class="page-header">
    <h1><i class="fas fa-list-ul" style="color: var(--primary, #4f46e5);"></i> My Requests</h1>
    <a href="@Url.Action("RequestDonation", "Donation")" class="btn-primary-pill"><i class="fas fa-plus"></i> New Request</a>
</div>

@if (TempData["Success"] != null)
{
    <div style="background:#d1fae5;color:#065f46;padding:14px 18px;border-radius:12px;margin-bottom:20px;font-size:13px;"><i class="fas fa-check-circle"></i> @TempData["Success"]</div>
}

@if (Model == null || !Model.Any())
{
    <div class="empty-state">
        <i class="fas fa-hand-paper"></i>
        <h4>No requests yet</h4>
        <p style="color:var(--gray-500,#6b7280);">Request an item when you need one &mdash; you'll see your place in the queue here.</p>
    </div>
}
else
{
    foreach (var request in Model)
    {
        <div class="request-card">
            <div class="request-head">
                <span class="request-ref">Request #REQ-@(request.Id.ToString("D6"))</span>
                <span class="request-date">Submitted @request.RequestDate.ToString("dd MMM yyyy")</span>
            </div>

            @foreach (var item in request.Items.OrderBy(i => i.Id))
            {
                var badgeClass = item.Status == RequestItemStatus.Waitlisted ? "badge-waitlisted"
                                : item.Status == RequestItemStatus.Reserved ? "badge-reserved"
                                : item.Status == RequestItemStatus.AwaitingCollection ? "badge-awaitingcollection"
                                : item.Status == RequestItemStatus.Fulfilled ? "badge-fulfilled"
                                : "badge-declined";

                <div class="req-item-row">
                    <div>
                        <div class="req-item-name">@item.ItemName <span style="color:var(--gray-400,#9ca3af); font-weight:400;">(@item.Category)</span></div>
                        <div class="req-item-meta">
                            Qty @item.QuantityRequested &middot; @item.Priority priority
                            @if (item.Status == RequestItemStatus.Waitlisted && queuePositions.ContainsKey(item.Id))
                            {
                                <span class="queue-pos"> &middot; #@queuePositions[item.Id] in the @item.Category queue</span>
                            }
                        </div>
                    </div>
                    <div style="display:flex; align-items:center; gap:10px;">
                        <span class="badge @badgeClass">@item.Status</span>
                        @if (item.Status == RequestItemStatus.Waitlisted)
                        {
                            <button type="button" class="btn-cancel-item" onclick="cancelItem(@item.Id, this)"><i class="fas fa-times"></i> Cancel</button>
                        }
                    </div>
                </div>
            }
        </div>
    }
}

<script>
    function cancelItem(id, btn) {
        if (!confirm('Cancel this request item?')) return;
        fetch('@Url.Action("CancelRequestItem", "Donation")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({ id: id })
        }).then(function (r) { return r.json(); }).then(function (data) {
            if (data.success) {
                location.reload();
            } else {
                alert(data.message || 'Could not cancel this item.');
            }
        });
    }
</script>
