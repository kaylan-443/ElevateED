@model List<ElevateED.Models.DonationHistory>
@{
    ViewBag.Title = "Donation History";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.ActiveTab = "history";
}

<style>
    .page-header { margin-bottom: 20px; }
    .page-header h1 { font-size: 24px; font-weight: 700; color: var(--gray-900, #111827); display: flex; align-items: center; gap: 10px; }

    .history-row { background: white; border: 1px solid var(--gray-200, #e5e7eb); border-radius: 14px; padding: 16px 20px; margin-bottom: 10px; display: flex; gap: 16px; align-items: flex-start; }
    .history-icon { width: 36px; height: 36px; border-radius: 10px; background: #eef2ff; color: #4338ca; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 14px; }
    .history-body { flex: 1; }
    .history-action { font-weight: 700; font-size: 13px; color: var(--gray-900, #111827); }
    .history-desc { font-size: 13px; color: var(--gray-600, #4b5563); margin-top: 2px; }
    .history-meta { font-size: 11px; color: var(--gray-400, #9ca3af); margin-top: 4px; }
    .history-item-link { color: var(--primary, #4f46e5); text-decoration: none; font-weight: 600; font-size: 12px; }

    .empty-state { text-align: center; padding: 60px 20px; background: white; border-radius: 16px; border: 1px solid var(--gray-200, #e5e7eb); }
    .empty-state i { font-size: 48px; color: var(--gray-300, #d1d5db); margin-bottom: 15px; }
</style>

@{ Html.RenderPartial("_DonationSubNav"); }

<div class="page-header">
    <h1><i class="fas fa-history" style="color: #4f46e5;"></i> Donation History</h1>
    <p style="color:var(--gray-500,#6b7280); font-size:13px;">The most recent 200 events across the donation pipeline &mdash; the audit trail for every approval, intake, match and collection.</p>
</div>

@if (Model == null || !Model.Any())
{
    <div class="empty-state">
        <i class="fas fa-history"></i>
        <h4>No activity logged yet</h4>
    </div>
}
else
{
    var icons = new Dictionary<string, string> {
        { "Submitted", "fa-gift" }, { "Approved", "fa-clipboard-check" }, { "Rejected", "fa-times-circle" },
        { "IntakeConfirmed", "fa-calendar-check" }, { "NotReceived", "fa-exclamation-triangle" },
        { "MatchProposed", "fa-link" }, { "MatchConfirmed", "fa-calendar-check" }, { "MatchReassigned", "fa-random" },
        { "MatchReleased", "fa-undo" }, { "CollectionMismatch", "fa-exclamation-circle" }, { "Collected", "fa-check-double" },
        { "Unclaimed", "fa-clock" }
    };
    foreach (var h in Model)
    {
        var icon = icons.ContainsKey(h.Action) ? icons[h.Action] : "fa-circle";
        <div class="history-row">
            <div class="history-icon"><i class="fas @icon"></i></div>
            <div class="history-body">
                <div class="history-action">@h.Action @(h.DonationItem != null ? ("\u2014 " + h.DonationItem.ItemName) : "")</div>
                <div class="history-desc">@h.Description</div>
                <div class="history-meta">@h.ActionDate.ToString("dd MMM yyyy HH:mm") &middot; by @(h.ActorType ?? "System")</div>
            </div>
            @if (h.DonationItem != null)
            {
                <a href="@Url.Action("DonationDetails", "Donation", new { id = h.DonationItemId })" class="history-item-link">View <i class="fas fa-arrow-right"></i></a>
            }
        </div>
    }
}
