@model ElevateED.Models.DonationInsightsViewModel
@{
    ViewBag.Title = "Donation Insights";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.ActiveTab = "insights";
}

<style>
    .page-header { margin-bottom: 20px; }
    .page-header h1 { font-size: 24px; font-weight: 700; color: var(--gray-900, #111827); display: flex; align-items: center; gap: 10px; }

    .filter-bar { background: white; border: 1px solid var(--gray-200, #e5e7eb); border-radius: 14px; padding: 16px 20px; margin-bottom: 24px; display: flex; gap: 14px; flex-wrap: wrap; align-items: flex-end; }
    .filter-bar .form-group label { display: block; font-size: 11px; font-weight: 600; color: var(--gray-500, #6b7280); margin-bottom: 4px; }
    .filter-bar .form-group input, .filter-bar .form-group select { padding: 9px 12px; border: 1px solid var(--gray-300, #d1d5db); border-radius: 10px; font-size: 13px; }
    .btn-filter { background: var(--primary, #4f46e5); color: white; border: none; padding: 10px 20px; border-radius: 10px; font-weight: 600; cursor: pointer; }

    .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 16px; margin-bottom: 28px; }
    .stat-card { background: white; border-radius: 16px; padding: 20px; border: 1px solid var(--gray-200, #e5e7eb); }
    .stat-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 18px; color: white; margin-bottom: 12px; }
    .stat-value { font-size: 26px; font-weight: 700; color: var(--gray-900, #111827); }
    .stat-label { font-size: 12px; color: var(--gray-500, #6b7280); margin-top: 2px; }

    .panel { background: white; border-radius: 16px; border: 1px solid var(--gray-200, #e5e7eb); padding: 24px; margin-bottom: 24px; }
    .panel-title { font-size: 15px; font-weight: 700; color: var(--gray-900, #111827); margin-bottom: 16px; }

    .gap-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--gray-100, #f3f4f6); font-size: 13px; }
    .gap-row:last-child { border-bottom: none; }
    .gap-positive { color: #991b1b; font-weight: 700; }
    .gap-negative { color: #065f46; font-weight: 700; }
</style>

@{ Html.RenderPartial("_DonationSubNav"); }

<div class="page-header">
    <h1><i class="fas fa-chart-pie" style="color: #10b981;"></i> Donation Insights</h1>
</div>

<form class="filter-bar" method="get" action="@Url.Action("Insights", "Donation")">
    <div class="form-group"><label>From</label><input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" /></div>
    <div class="form-group"><label>To</label><input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" /></div>
    <div class="form-group">
        <label>Category</label>
        <select name="category">
            <option value="">All</option>
            @foreach (ElevateED.Models.DonationCategory c in Enum.GetValues(typeof(ElevateED.Models.DonationCategory)))
            {
                if (c == ElevateED.Models.DonationCategory.Food) { continue; }
                <option value="@c" selected="@(Model.CategoryFilter == c.ToString())">@c</option>
            }
        </select>
    </div>
    <div class="form-group"><label>Grade</label><input type="text" name="grade" value="@Model.GradeFilter" placeholder="e.g. Grade 10" /></div>
    <button type="submit" class="btn-filter"><i class="fas fa-filter"></i> Apply</button>
</form>

<div class="stat-grid">
    <div class="stat-card"><div class="stat-icon" style="background:#4f46e5;"><i class="fas fa-hand-paper"></i></div><div class="stat-value">@Model.TotalRequests</div><div class="stat-label">Total Requests</div></div>
    <div class="stat-card"><div class="stat-icon" style="background:#10b981;"><i class="fas fa-check-circle"></i></div><div class="stat-value">@Model.FulfilmentRatePercent%</div><div class="stat-label">Fulfilment Rate</div></div>
    <div class="stat-card"><div class="stat-icon" style="background:#f59e0b;"><i class="fas fa-clock"></i></div><div class="stat-value">@Model.AverageWaitDays</div><div class="stat-label">Avg. Wait (days)</div></div>
    <div class="stat-card"><div class="stat-icon" style="background:#ef4444;"><i class="fas fa-exclamation-triangle"></i></div><div class="stat-value">@Model.UnclaimedRatePercent%</div><div class="stat-label">Unclaimed Rate</div></div>
    <div class="stat-card"><div class="stat-icon" style="background:#8b5cf6;"><i class="fas fa-gift"></i></div><div class="stat-value">@Model.TotalDonationsReceived</div><div class="stat-label">Donations Received</div></div>
</div>

<div class="panel">
    <div class="panel-title"><i class="fas fa-balance-scale"></i> Supply vs Demand by Category</div>
    <canvas id="gapChart" height="90"></canvas>
</div>

<div class="panel">
    <div class="panel-title"><i class="fas fa-list"></i> Category Gaps (Open Requests − Available Items)</div>
    @foreach (var g in Model.CategoryGaps)
    {
        <div class="gap-row">
            <span>@g.Category</span>
            <span>@g.OpenRequests requested · @g.AvailableItems available ·
                <span class="@(g.Gap > 0 ? "gap-positive" : "gap-negative")">@(g.Gap > 0 ? "Shortfall of " + g.Gap : "Surplus of " + (-g.Gap))</span>
            </span>
        </div>
    }
</div>

@if (Model.TopUnclaimedReasons != null && Model.TopUnclaimedReasons.Any())
{
    <div class="panel">
        <div class="panel-title"><i class="fas fa-undo"></i> Where Unclaimed Items Cluster</div>
        @foreach (var kv in Model.TopUnclaimedReasons)
        {
            <div class="gap-row"><span>@kv.Key</span><span>@kv.Value unclaimed item(s)</span></div>
        }
    </div>
}

<script>
    var ctx = document.getElementById('gapChart').getContext('2d');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Encode(Model.CategoryGaps.Select(g => g.Category).ToList())),
            datasets: [
                { label: 'Open Requests', data: @Html.Raw(Json.Encode(Model.CategoryGaps.Select(g => g.OpenRequests).ToList())), backgroundColor: '#ef4444' },
                { label: 'Available Items', data: @Html.Raw(Json.Encode(Model.CategoryGaps.Select(g => g.AvailableItems).ToList())), backgroundColor: '#10b981' }
            ]
        },
        options: { responsive: true, scales: { y: { beginAtZero: true } } }
    });
</script>
