            <div class="hero-brand">
                ELEVATE / DONATION INTELLIGENCE
            </div>

            <div class="hero-online">
                <span class="hero-online-dot"></span>
                ANALYTICS ONLINE
            </div>

        </div>

        <div class="hero-content">

            <h1>
                <i class="fas fa-brain"></i>
                Donation Intelligence Centre
            </h1>

            <p>
                Turn donation activity into operational decisions.
                Review supply, learner demand, fulfilment, waiting time
                and unclaimed items from one command view.
            </p>

            <div class="hero-tags">

                <div class="hero-tag">
                    <strong>@Model.TotalRequests</strong>
                    requests analysed
                </div>

                <div class="hero-tag">
                    <strong>@Model.TotalDonationsReceived</strong>
                    donations received
                </div>

                <div class="hero-tag">
                    <strong>@Model.FulfilmentRatePercent%</strong>
