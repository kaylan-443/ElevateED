            CATEGORY ANALYSIS
        </span>

    </div>


    <div class="chart-panel">

        <div class="panel-title">

            <i class="fas fa-balance-scale"></i>

            Supply vs Demand by Category

        </div>


        <div class="chart-wrap">

            <canvas id="gapChart"></canvas>

            <div id="chartStatus"
                 class="chart-status">

                <span>
                    <i class="fas fa-spinner fa-spin"></i>
                    Loading donation intelligence...
                </span>

            </div>

        </div>

    </div>


    <!-- =====================================================
         PRIORITY GAP DETECTION
         ===================================================== -->

    <div class="gap-panel">

        <div class="panel-title">

            <i class="fas fa-crosshairs"></i>

            Priority Gap Detection

        </div>


        <div class="gap-list">

            @if (
                Model.CategoryGaps != null &&
                Model.CategoryGaps.Any()
            )
            {
                foreach (var g in Model.CategoryGaps)
                {

                    <div class="gap-row">

                        <span class="gap-category">
                            @g.Category
                        </span>

                        <span class="gap-data">

                            @g.OpenRequests requested
                            ·
                            @g.AvailableItems available

                        </span>


                        <span class="
                            @(g.Gap > 0
                                ? "gap-positive"
                                : g.Gap < 0
                                    ? "gap-negative"
                                    : "gap-neutral")
                        ">

                            @if (g.Gap > 0)
                            {
                                @:SHORTFALL · @g.Gap
                            }
                            else if (g.Gap < 0)
                            {
                                @:SURPLUS · @(-g.Gap)
                            }
                            else
                            {
                                @:BALANCED
                            }

                        </span>

                    </div>
                }
            }
            else
            {

                <div class="insight-note">

                    <i class="fas fa-info-circle"></i>

                    <span>
