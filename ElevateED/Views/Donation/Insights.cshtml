                        ElevateED.Models.DonationCategory.Food
                    )
                    {
                        continue;
                    }

                    <option value="@c"
                            @(Model.CategoryFilter == c.ToString() ? "selected" : "")>
                        @c
                    </option>
                }

            </select>

        </div>


        <div class="form-group">

            <label>Grade</label>

            <input type="text"
                   name="grade"
                   value="@Model.GradeFilter"
