<!-- =========================================================
     CHART SCRIPT
     COMPLETELY SEPARATE FROM AI
     ========================================================= -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    var canvas = document.getElementById("gapChart");
    var status = document.getElementById("chartStatus");

    if (!canvas) {

        console.error(
            "ELEVATE Insights: gapChart canvas was not found."
        );

        return;
    }


    /*
     * Razor converts the database values into JavaScript arrays.
     *
     * IMPORTANT:
     * We use null rather than List<object> here.
     * This prevents the Razor CS0173 conditional-expression error.
     */

    var categoryLabels = @Html.Raw(
        Json.Encode(
            Model.CategoryGaps == null
                ? null
                : Model.CategoryGaps
                    .Select(g => g.Category)
                    .ToList()
        )
    ) || [];


    var openRequests = @Html.Raw(
        Json.Encode(
            Model.CategoryGaps == null
                ? null
                : Model.CategoryGaps
                    .Select(g => g.OpenRequests)
                    .ToList()
        )
    ) || [];


    var availableItems = @Html.Raw(
        Json.Encode(
            Model.CategoryGaps == null
                ? null
                : Model.CategoryGaps
                    .Select(g => g.AvailableItems)
                    .ToList()
        )
    ) || [];


    var gaps = @Html.Raw(
        Json.Encode(
            Model.CategoryGaps == null
                ? null
                : Model.CategoryGaps
                    .Select(g => g.Gap)
                    .ToList()
        )
    ) || [];


    console.log(
        "ELEVATE Insights - Categories:",
        categoryLabels
    );

    console.log(
        "ELEVATE Insights - Open Requests:",
        openRequests
    );

    console.log(
        "ELEVATE Insights - Available Items:",
        availableItems
    );

    console.log(
        "ELEVATE Insights - Gaps:",
        gaps
    );


    function showStatus(message) {

        if (!status) {
            return;
        }

        status.style.display = "flex";

        status.innerHTML =
            "<span>" +
            "<i class='fas fa-info-circle'></i>" +
            message +
            "</span>";

    }


    function hideStatus() {

        if (status) {
            status.style.display = "none";
        }

    }


    function createChart() {

        /*
         * Chart.js has not loaded.
         */

        if (typeof Chart === "undefined") {

            console.error(
                "ELEVATE Insights: Chart.js is not available."
            );

            showStatus(
                "Chart engine unavailable. Please refresh the page."
            );

            return false;
        }


        /*
         * There is no category data.
         */

        if (
            !categoryLabels ||
            categoryLabels.length === 0
        ) {

            console.warn(
                "ELEVATE Insights: No CategoryGaps data."
            );

            showStatus(
                "No category data is available for the selected filters."
            );

            return false;
        }


        hideStatus();


        /*
         * Destroy an existing chart if the page
         * has already created one.
         */

        var existingChart =
            Chart.getChart(canvas);

        if (existingChart) {
            existingChart.destroy();
        }


        var ctx =
            canvas.getContext("2d");


        /*
         * CREATE THE CHART
         */

        new Chart(ctx, {

            type: "bar",


            data: {

                labels: categoryLabels,


                datasets: [

                    {

                        label: "Open Requests",

                        data: openRequests,

                        backgroundColor:
                            "rgba(251,113,133,.72)",

                        borderColor:
                            "#fb7185",

                        borderWidth: 1,

                        borderRadius: 7,

                        maxBarThickness: 34

                    },


                    {

                        label: "Available Items",

                        data: availableItems,

                        backgroundColor:
                            "rgba(34,211,238,.62)",

                        borderColor:
                            "#22d3ee",

                        borderWidth: 1,

                        borderRadius: 7,

                        maxBarThickness: 34

                    }

                ]

            },


            options: {

                responsive: true,

                maintainAspectRatio: false,


                interaction: {

                    mode: "index",

                    intersect: false

                },


                plugins: {

                    legend: {

                        position: "top",

                        labels: {

                            color: "#aebbd0",

                            boxWidth: 10,

                            boxHeight: 10,

                            padding: 18,

                            font: {
                                size: 10
                            }

                        }

                    },


                    tooltip: {

                        backgroundColor:
                            "#0b1020",

                        borderColor:
                            "rgba(34,211,238,.2)",

                        borderWidth: 1,

                        titleColor: "#fff",

                        bodyColor: "#b9c5d8",

                        padding: 11,


                        callbacks: {

                            footer: function (items) {

                                if (
                                    !items ||
                                    !items.length
                                ) {
                                    return "";
                                }


                                var index =
                                    items[0].dataIndex;


                                var gap =
                                    Number(gaps[index] || 0);


                                if (gap > 0) {

                                    return (
                                        "Shortfall: " +
                                        gap
                                    );

                                }


                                if (gap < 0) {

                                    return (
                                        "Surplus: " +
                                        Math.abs(gap)
                                    );

                                }


                                return "Balanced";

                            }

                        }

                    }

                },


                scales: {

                    x: {

                        grid: {
                            display: false
                        },

                        ticks: {

                            color:
                                "#71819b",

                            font: {
                                size: 9
                            }

                        }

                    },


                    y: {

                        beginAtZero: true,

                        grid: {

                            color:
                                "rgba(255,255,255,.055)"

                        },

                        ticks: {

                            color:
                                "#71819b",

                            precision: 0,

                            font: {
                                size: 9
                            }

                        }

                    }

                }

            }

        });


        return true;

    }


    /*
     * Try to create the chart.
     */

    if (!createChart()) {

        /*
         * If Chart.js was not loaded by the CDN,
         * try loading it again dynamically.
         */

        if (typeof Chart === "undefined") {

            console.log(
                "ELEVATE Insights: Attempting to load Chart.js again..."
            );


            var retryScript =
                document.createElement("script");

            retryScript.src =
                "https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js";


            retryScript.onload =
                function () {

                    console.log(
                        "ELEVATE Insights: Chart.js loaded on retry."
                    );

                    createChart();

                };


            retryScript.onerror =
                function () {

                    console.error(
                        "ELEVATE Insights: Chart.js failed to load."
                    );

                    showStatus(
                        "Unable to load the chart engine. Check your internet connection."
                    );

                };


            document.head.appendChild(
                retryScript
            );

        }

    }

});

</script>


<!-- =========================================================
     ELEVATE AI SCRIPT
     COMPLETELY SEPARATE FROM CHART
     ========================================================= -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    var aiRoot =
        document.getElementById("eiAiRoot");

    var aiOrb =
        document.getElementById("eiAiOrb");

    var aiClose =
        document.getElementById("eiAiClose");

    var aiPrevious =
        document.getElementById("eiAiPrevious");

    var aiNext =
        document.getElementById("eiAiNext");

    var aiReplay =
        document.getElementById("eiAiReplay");

    var aiThinking =
        document.getElementById("eiAiThinking");

    var aiThinkingText =
        document.getElementById("eiAiThinkingText");

    var aiMessage =
        document.getElementById("eiAiMessage");

    var aiLabel =
        document.getElementById("eiAiLabel");

    var aiText =
        document.getElementById("eiAiText");

    var aiProgress =
        document.getElementById("eiAiProgress");

    var aiCounter =
        document.getElementById("eiAiCounter");

    var aiAction =
        document.getElementById("eiAiAction");


    /*
     * Safety check.
     */

    if (
        !aiRoot ||
        !aiOrb ||
        !aiClose ||
        !aiPrevious ||
        !aiNext ||
        !aiReplay ||
        !aiThinking ||
        !aiThinkingText ||
        !aiMessage ||
        !aiLabel ||
        !aiText ||
        !aiProgress ||
        !aiCounter
    ) {

        console.error(
            "ELEVATE AI: One or more AI elements are missing."
        );

        return;

    }


    /*
     * Read category data from Razor.
     */

    var categoryGaps = @Html.Raw(
        Json.Encode(
            Model.CategoryGaps == null
                ? null
                : Model.CategoryGaps
                    .Select(g => new
                    {
                        Category = g.Category,
                        OpenRequests = g.OpenRequests,
                        AvailableItems = g.AvailableItems,
                        Gap = g.Gap
                    })
                    .ToList()
        )
    ) || [];


    /*
     * Read unclaimed reasons.
     */

    var unclaimedReasons = @Html.Raw(
        Json.Encode(
            Model.TopUnclaimedReasons == null
                ? null
                : Model.TopUnclaimedReasons
                    .Select(kv => new
                    {
                        Reason = kv.Key,
                        Count = kv.Value
                    })
                    .ToList()
        )
    ) || [];


    var facts = [];

    var currentIndex = 0;

    var thinking = false;

    var timer = null;


    function addFact(
        type,
        label,
        text,
        actionUrl
    ) {

        facts.push({

            type: type,

            label: label,

            text: text,

            actionUrl:
                actionUrl || null

        });

    }


    /*
     * ---------------------------------------------------------
     * OPENING
     * ---------------------------------------------------------
     */

    addFact(
        "info",

        "ELEVATE AI",

        "I've analysed the donation readings for the current scope. I'll highlight the most important operational signals one at a time.",

        null
    );


    /*
     * ---------------------------------------------------------
     * FULFILMENT
     * ---------------------------------------------------------
     */

    var fulfilment =
        Number("@Model.FulfilmentRatePercent");


    if (fulfilment >= 80) {

        addFact(
            "good",
            "FULFILMENT · STABLE",

            "Fulfilment is currently " +
            fulfilment +
            "%. The operation is converting a strong proportion of requests into successful outcomes.",

            null
        );

    }
    else if (fulfilment >= 50) {

        addFact(
            "info",
            "FULFILMENT · MONITOR",

            "Fulfilment is currently " +
            fulfilment +
            "%. There is room to improve how efficiently available donations reach requesting learners.",

            null
        );

    }
    else {

        addFact(
            "attention",
            "FULFILMENT · PRIORITY",

            "Only " +
            fulfilment +
            "% of requests are currently fulfilled. This is a significant operational signal and should be prioritised.",

            null
        );

    }


    /*
     * ---------------------------------------------------------
     * WAITING TIME
     * ---------------------------------------------------------
     */

    var waitDays =
        Number("@Model.AverageWaitDays");


    if (waitDays <= 3) {

        addFact(
            "good",
            "WAIT TIME · HEALTHY",

            "Average waiting time is " +
            waitDays +
            " day(s), indicating that requests are moving through the process relatively quickly.",

            null
        );

    }
    else if (waitDays <= 7) {

        addFact(
            "info",
            "WAIT TIME · MONITOR",

            "Average waiting time is " +
            waitDays +
            " day(s). Matching and collection queues should be monitored for avoidable delays.",

            null
        );

    }
    else {

        addFact(
            "attention",
            "WAIT TIME · WARNING",

            "Average waiting time is " +
            waitDays +
            " day(s). Requests may be remaining unresolved for too long and deserve administrative attention.",

            null
        );

    }


    /*
     * ---------------------------------------------------------
     * UNCLAIMED
     * ---------------------------------------------------------
     */

    var unclaimed =
        Number("@Model.UnclaimedRatePercent");


    if (unclaimed >= 20) {

        addFact(
            "attention",
            "UNCLAIMED · HIGH",

            "The unclaimed rate is " +
            unclaimed +
            "%. A significant portion of donated items may not be reaching their intended recipients.",

            null
        );

    }
    else if (unclaimed > 5) {

        addFact(
            "info",
            "UNCLAIMED · REVIEW",

            "The unclaimed rate is " +
            unclaimed +
            "%. Review collection follow-ups and the reasons items remain unclaimed.",

            null
        );

    }
    else {

        addFact(
            "good",
            "UNCLAIMED · LOW",

            "The unclaimed rate is only " +
            unclaimed +
            "%. Most allocated items appear to be progressing successfully to collection.",

            null
        );

    }


    /*
     * ---------------------------------------------------------
     * CATEGORY GAP
     * ---------------------------------------------------------
     */

    var shortage = null;


    categoryGaps.forEach(function (g) {

        var gap =
            Number(g.Gap || 0);


        if (
            gap > 0 &&
            (
                !shortage ||
                gap > Number(shortage.Gap)
            )
        ) {

            shortage = g;

        }

    });


    if (shortage) {

        addFact(
            "attention",

            "DEMAND GAP DETECTED",

            shortage.Category +
            " currently has " +
            shortage.OpenRequests +
            " open request(s) against " +
            shortage.AvailableItems +
            " available item(s), creating a shortfall of " +
            shortage.Gap +
            ".",

            null
        );

    }
    else if (categoryGaps.length > 0) {

        addFact(
            "good",

            "SUPPLY · BALANCED",

            "No category currently shows a positive demand shortfall in the selected data. Continue monitoring the category gaps as new requests and donations arrive.",

            null
        );

    }
    else {

        addFact(
            "info",

            "GAP MONITOR",

            "There is no category gap data for the selected scope, so the system cannot identify a supply shortage from this reading.",

            null
        );

    }


    /*
     * ---------------------------------------------------------
     * UNCLAIMED PATTERN
     * ---------------------------------------------------------
     */

    if (
        unclaimedReasons &&
        unclaimedReasons.length > 0
    ) {

        var topReason =
            unclaimedReasons[0];


        addFact(
            "attention",

            "UNCLAIMED PATTERN",

            "The leading recorded unclaimed reason is \"" +
            topReason.Reason +
            "\" with " +
            topReason.Count +
            " item(s). This is a useful starting point for collection follow-up.",

            null
        );

    }


    /*
     * ---------------------------------------------------------
     * NEXT BEST ACTION
     * ---------------------------------------------------------
     */

    if (shortage) {

        addFact(
            "recommendation",

            "NEXT BEST ACTION",

            "Prioritise " +
            shortage.Category +
            " in donation matching and targeted collection efforts. The current demand gap is the clearest supply-side signal in this analysis.",

            "@Url.Action("MatchDonations", "Donation")"
        );

    }
    else if (
        unclaimed >= 20 ||
        waitDays > 7
    ) {

        addFact(
            "recommendation",

            "NEXT BEST ACTION",

            "Focus on resolving outstanding allocations and collection delays before expanding inventory. Reducing operational friction should improve learner outcomes.",

            "@Url.Action("ProcessCollection", "Donation")"
        );

    }
    else {

        addFact(
            "recommendation",

            "NEXT BEST ACTION",

            "Continue monitoring fulfilment, waiting time and category gaps. The strongest operational gains will come from acting on any new shortfalls as they appear.",

            "@Url.Action("MatchDonations", "Donation")"
        );

    }


    /*
     * ---------------------------------------------------------
     * BUTTON STATE
     * ---------------------------------------------------------
     */

    function updateButtons() {

        aiPrevious.disabled =
            thinking ||
            currentIndex <= 0;


        aiNext.disabled =
            thinking ||
            currentIndex >= facts.length - 1;


        aiCounter.textContent =
            (currentIndex + 1) +
            " / " +
            facts.length;


        aiProgress.style.width =
            (
                ((currentIndex + 1) /
                facts.length) *
                100
            ) +
            "%";

    }


    /*
     * ---------------------------------------------------------
     * DISPLAY FACT
     * ---------------------------------------------------------
     */

    function showFact(
        index,
        animate
    ) {

        if (
            index < 0 ||
            index >= facts.length
        ) {
            return;
        }


        if (thinking) {
            return;
        }


        currentIndex = index;


        var fact =
            facts[currentIndex];


        if (animate) {

            thinking = true;


            aiThinking.style.display =
                "flex";


            aiThinkingText.textContent =
                "ANALYSING " +
                fact.label;


            aiMessage.style.opacity =
                ".35";


            updateButtons();


            if (timer) {
                clearTimeout(timer);
            }


            timer =
                setTimeout(
                    function () {

                        renderFact(fact);

                    },
                    650
                );

        }
        else {

            renderFact(fact);

        }

    }


    /*
     * ---------------------------------------------------------
     * RENDER
     * ---------------------------------------------------------
     */

    function renderFact(fact) {

        aiLabel.textContent =
            fact.label;


        aiText.textContent =
            fact.text;


        aiMessage.className =
            "ei-ai-message " +
            fact.type;


        aiMessage.style.opacity =
            "1";


        if (
            aiAction &&
            fact.actionUrl
        ) {

            aiAction.href =
                fact.actionUrl;

            aiAction.style.display =
                "inline-flex";

        }
        else if (aiAction) {

            aiAction.style.display =
                "none";

        }


        aiThinking.style.display =
            "none";


        thinking = false;


        updateButtons();

    }


    /*
     * ---------------------------------------------------------
     * OPEN
     * ---------------------------------------------------------
     */

    function openAI() {

        aiRoot.classList.add(
            "open"
        );


        showFact(
            currentIndex,
            true
        );

    }


    /*
     * ---------------------------------------------------------
     * CLOSE
     * ---------------------------------------------------------
     */

    function closeAI() {

        aiRoot.classList.remove(
            "open"
        );

    }


    /*
     * ---------------------------------------------------------
     * REPLAY
     * ---------------------------------------------------------
     */

    function replayAI() {

        currentIndex = 0;

        showFact(
            0,
            true
        );

    }


    /*
     * ---------------------------------------------------------
     * EVENTS
     * ---------------------------------------------------------
     */

    aiOrb.addEventListener(
        "click",
        function () {

            openAI();

        }
    );


    aiClose.addEventListener(
        "click",
        function () {

            closeAI();

        }
    );


    aiPrevious.addEventListener(
        "click",
        function () {

            if (
                currentIndex > 0
            ) {

                showFact(
                    currentIndex - 1,
                    true
                );

            }

        }
    );


    aiNext.addEventListener(
        "click",
        function () {

            if (
                currentIndex <
                facts.length - 1
            ) {

                showFact(
                    currentIndex + 1,
                    true
                );

            }

        }
    );


    aiReplay.addEventListener(
        "click",
        function () {

            replayAI();

        }
    );


    /*
     * ---------------------------------------------------------
     * KEYBOARD
     * ---------------------------------------------------------
     */

    document.addEventListener(
        "keydown",
        function (event) {

            var tag =
                document.activeElement
                    ? document.activeElement.tagName
                    : "";


            if (
                tag === "INPUT" ||
                tag === "TEXTAREA" ||
                tag === "SELECT"
            ) {
                return;
            }


            if (
                !aiRoot.classList.contains(
                    "open"
                )
            ) {
                return;
            }


            if (
                event.key === "ArrowLeft"
            ) {

                if (
                    currentIndex > 0
                ) {

                    showFact(
                        currentIndex - 1,
                        true
                    );

                }

            }


            if (
                event.key === "ArrowRight"
            ) {

                if (
                    currentIndex <
                    facts.length - 1
                ) {

                    showFact(
                        currentIndex + 1,
                        true
                    );

                }

            }


            if (
                event.key === "Escape"
            ) {

                closeAI();

            }

        }
    );


    /*
     * Initial state.
     *
     * The orb remains closed.
     * Only the first briefing is prepared.
     */

    showFact(
        0,
        false
    );


});

</script>