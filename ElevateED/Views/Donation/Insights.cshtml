@model ElevateED.Models.DonationInsightsViewModel

@{
    ViewBag.Title = "Donation Insights";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.ActiveTab = "insights";
}

<style>
    :root {
        --ei-bg: #070b14;
        --ei-panel: rgba(13, 19, 33, .86);
        --ei-panel-2: rgba(18, 25, 43, .92);
        --ei-border: rgba(148, 163, 184, .13);
        --ei-cyan: #22d3ee;
        --ei-blue: #38bdf8;
        --ei-purple: #8b5cf6;
        --ei-violet: #a78bfa;
        --ei-green: #34d399;
        --ei-amber: #fbbf24;
        --ei-red: #fb7185;
        --ei-text: #f4f7ff;
        --ei-muted: #8493ad;
    }

    /* =========================================================
       MAIN
       ========================================================= */

    .insights-centre {
        position: relative;
        min-height: 100%;
        color: var(--ei-text);
    }

        .insights-centre::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            background: radial-gradient(circle at 12% 5%, rgba(34,211,238,.075), transparent 27%), radial-gradient(circle at 88% 12%, rgba(139,92,246,.09), transparent 30%), linear-gradient(rgba(255,255,255,.017) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.017) 1px, transparent 1px);
            background-size: auto, auto, 42px 42px, 42px 42px;
        }

    /* =========================================================
       HERO
       ========================================================= */

    .insights-hero {
        position: relative;
        overflow: hidden;
        padding: 28px 30px;
        margin-bottom: 18px;
        border: 1px solid rgba(34,211,238,.15);
        border-radius: 24px;
        background: radial-gradient(circle at 78% 20%, rgba(34,211,238,.12), transparent 25%), radial-gradient(circle at 100% 100%, rgba(139,92,246,.18), transparent 34%), linear-gradient(135deg, #0a1020, #0d1425 55%, #11152a);
        box-shadow: 0 24px 70px rgba(0,0,0,.2), inset 0 1px 0 rgba(255,255,255,.04);
    }

        .insights-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(rgba(255,255,255,.024) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.024) 1px, transparent 1px);
            background-size: 34px 34px;
            mask-image: linear-gradient(to right, black, transparent 82%);
        }

        .insights-hero::after {
            content: "◈";
            position: absolute;
            right: 7%;
            top: 12%;
            font-size: 120px;
            line-height: 1;
            color: rgba(34,211,238,.055);
            animation: insightFloat 5s ease-in-out infinite;
        }

    .hero-topline {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
    }

    .hero-brand {
        color: #8191ab;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .hero-online {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        border: 1px solid rgba(52,211,153,.18);
        border-radius: 999px;
        background: rgba(52,211,153,.055);
        color: #6ee7b7;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 1.2px;
    }

    .hero-online-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--ei-green);
        box-shadow: 0 0 11px var(--ei-green);
        animation: onlinePulse 1.8s infinite;
    }

    .hero-content {
        position: relative;
        z-index: 2;
    }

        .hero-content h1 {
            margin: 0 0 7px;
            color: #fff;
            font-size: clamp(26px, 3vw, 38px);
            font-weight: 800;
            letter-spacing: -.8px;
        }

            .hero-content h1 i {
                margin-right: 8px;
                color: var(--ei-cyan);
                filter: drop-shadow(0 0 12px rgba(34,211,238,.55));
            }

        .hero-content p {
            max-width: 700px;
            margin: 0;
            color: #8e9db6;
            font-size: 12px;
            line-height: 1.7;
        }

    .hero-tags {
        position: relative;
        z-index: 2;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 17px;
    }

    .hero-tag {
        padding: 7px 10px;
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 9px;
        background: rgba(255,255,255,.035);
        color: #aebbd0;
        font-size: 9px;
    }

        .hero-tag strong {
            color: #fff;
        }

    /* =========================================================
       SECTION HEADINGS
       ========================================================= */

    .section-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin: 24px 2px 11px;
    }

        .section-heading h2 {
            margin: 0;
            color: #f3f6ff;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .section-heading p {
            margin: 4px 0 0;
            color: #65748d;
            font-size: 9px;
        }

    .section-badge {
        color: #65748d;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 1.1px;
    }

    /* =========================================================
       FILTERS
       ========================================================= */

    .filter-bar {
        display: flex;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 12px;
        padding: 14px;
        margin-bottom: 18px;
        border: 1px solid var(--ei-border);
        border-radius: 17px;
        background: rgba(10,15,27,.78);
        box-shadow: 0 12px 35px rgba(0,0,0,.12);
    }

        .filter-bar .form-group {
            margin: 0;
        }

            .filter-bar .form-group label {
                display: block;
                margin: 0 0 5px 2px;
                color: #73829b;
                font-size: 9px;
                font-weight: 800;
                letter-spacing: .8px;
                text-transform: uppercase;
            }

        .filter-bar input,
        .filter-bar select {
            min-height: 38px;
            padding: 8px 11px;
            color: #e9effa;
            background: rgba(255,255,255,.045);
            border: 1px solid rgba(255,255,255,.09);
            border-radius: 10px;
            outline: none;
            font-size: 11px;
        }

            .filter-bar input:focus,
            .filter-bar select:focus {
                border-color: rgba(34,211,238,.45);
                box-shadow: 0 0 0 3px rgba(34,211,238,.06);
            }

            .filter-bar select option {
                background: #0d1425;
                color: #fff;
            }

    .btn-filter {
        min-height: 38px;
        padding: 9px 17px;
        border: 1px solid rgba(34,211,238,.25);
        border-radius: 10px;
        color: #fff;
        background: linear-gradient( 135deg, rgba(34,211,238,.18), rgba(79,70,229,.28) );
        box-shadow: 0 8px 25px rgba(34,211,238,.08);
        font-size: 10px;
        font-weight: 800;
        cursor: pointer;
        transition: .2s ease;
    }

        .btn-filter:hover {
            transform: translateY(-1px);
            border-color: rgba(34,211,238,.45);
            box-shadow: 0 10px 30px rgba(34,211,238,.12);
        }

    /* =========================================================
       STATISTICS
       ========================================================= */

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 11px;
        margin-bottom: 20px;
    }

    .stat-card {
        position: relative;
        overflow: hidden;
        min-height: 145px;
        padding: 16px;
        border: 1px solid var(--ei-border);
        border-radius: 17px;
        background: linear-gradient( 145deg, rgba(15,23,42,.86), rgba(9,14,25,.94) );
        box-shadow: 0 12px 35px rgba(0,0,0,.15), inset 0 1px 0 rgba(255,255,255,.025);
        transition: .25s ease;
    }

        .stat-card::after {
            content: "";
            position: absolute;
            right: -50px;
            bottom: -55px;
            width: 110px;
            height: 110px;
            border-radius: 50%;
            background: rgba(34,211,238,.08);
        }

        .stat-card:nth-child(2)::after {
            background: rgba(52,211,153,.08);
        }

        .stat-card:nth-child(3)::after {
            background: rgba(251,191,36,.08);
        }

        .stat-card:nth-child(4)::after {
            background: rgba(251,113,133,.08);
        }

        .stat-card:nth-child(5)::after {
            background: rgba(139,92,246,.08);
        }

        .stat-card:hover {
            transform: translateY(-3px);
            border-color: rgba(34,211,238,.25);
            box-shadow: 0 18px 42px rgba(0,0,0,.22), 0 0 22px rgba(34,211,238,.045);
        }

    .stat-icon {
        width: 39px;
        height: 39px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 15px;
        border-radius: 11px !important;
        color: #fff;
        border: 1px solid rgba(255,255,255,.08);
        background: linear-gradient( 135deg, rgba(34,211,238,.18), rgba(139,92,246,.2) ) !important;
        box-shadow: 0 0 18px rgba(34,211,238,.07);
    }

    .stat-card:nth-child(2) .stat-icon {
        background: linear-gradient( 135deg, rgba(52,211,153,.18), rgba(34,211,238,.14) ) !important;
    }

    .stat-card:nth-child(3) .stat-icon {
        background: linear-gradient( 135deg, rgba(251,191,36,.18), rgba(245,158,11,.12) ) !important;
    }

    .stat-card:nth-child(4) .stat-icon {
        background: linear-gradient( 135deg, rgba(251,113,133,.18), rgba(239,68,68,.12) ) !important;
    }

    .stat-card:nth-child(5) .stat-icon {
        background: linear-gradient( 135deg, rgba(139,92,246,.2), rgba(167,139,250,.14) ) !important;
    }

    .stat-value {
        position: relative;
        z-index: 1;
        color: #fff;
        font-size: 28px;
        font-weight: 800;
        line-height: 1;
    }

    .stat-label {
        position: relative;
        z-index: 1;
        margin-top: 7px;
        color: #7888a1;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .7px;
        text-transform: uppercase;
    }

    /* =========================================================
       CHART
       ========================================================= */

    .chart-panel {
        position: relative;
        overflow: hidden;
        padding: 20px;
        margin-bottom: 18px;
        border: 1px solid var(--ei-border);
        border-radius: 19px;
        background: linear-gradient( 145deg, rgba(15,23,42,.82), rgba(8,13,24,.92) );
        box-shadow: 0 12px 35px rgba(0,0,0,.13), inset 0 1px 0 rgba(255,255,255,.025);
    }

    .panel-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 16px;
        color: #f5f7ff;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

        .panel-title i {
            color: var(--ei-cyan);
            filter: drop-shadow( 0 0 8px rgba(34,211,238,.4) );
        }

    .chart-wrap {
        position: relative;
        height: 330px;
        width: 100%;
    }

    #gapChart {
        display: block;
        width: 100% !important;
        height: 100% !important;
    }

    .chart-status {
        display: none;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #71819b;
        font-size: 10px;
        text-align: center;
    }

        .chart-status i {
            margin-right: 7px;
            color: var(--ei-cyan);
        }

    /* =========================================================
       GAP TABLE
       ========================================================= */

    .gap-panel {
        padding: 20px;
        margin-bottom: 18px;
        border: 1px solid var(--ei-border);
        border-radius: 19px;
        background: linear-gradient( 145deg, rgba(15,23,42,.82), rgba(8,13,24,.92) );
    }

    .gap-list {
        display: grid;
        gap: 3px;
    }

    .gap-row {
        display: grid;
        grid-template-columns: minmax(120px,.8fr) minmax(260px,1.4fr) auto;
        gap: 12px;
        align-items: center;
        padding: 11px 10px;
        border-bottom: 1px solid rgba(255,255,255,.045);
        font-size: 10px;
    }

        .gap-row:last-child {
            border-bottom: none;
        }

    .gap-category {
        color: #e7edf8;
        font-weight: 700;
    }

    .gap-data {
        color: #7888a1;
    }

    .gap-positive {
        color: #fb7185;
        font-weight: 800;
    }

    .gap-negative {
        color: #6ee7b7;
        font-weight: 800;
    }

    .gap-neutral {
        color: #9ca8ba;
        font-weight: 800;
    }

    /* =========================================================
       UNCLAIMED
       ========================================================= */

    .unclaimed-panel {
        padding: 20px;
        margin-bottom: 20px;
        border: 1px solid var(--ei-border);
        border-radius: 19px;
        background: linear-gradient( 145deg, rgba(15,23,42,.82), rgba(8,13,24,.92) );
    }

    .unclaimed-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 11px 0;
        border-bottom: 1px solid rgba(255,255,255,.045);
        color: #aebbd0;
        font-size: 10px;
    }

        .unclaimed-row:last-child {
            border-bottom: none;
        }

    .unclaimed-count {
        min-width: 28px;
        padding: 4px 7px;
        border-radius: 7px;
        background: rgba(251,113,133,.08);
        color: #fb7185;
        font-size: 9px;
        font-weight: 800;
        text-align: center;
    }

    /* =========================================================
       NOTE
       ========================================================= */

    .insight-note {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        padding: 12px 14px;
        margin-bottom: 25px;
        border: 1px solid rgba(34,211,238,.09);
        border-radius: 12px;
        background: rgba(34,211,238,.035);
        color: #71819b;
        font-size: 9px;
        line-height: 1.55;
    }

        .insight-note i {
            margin-top: 2px;
            color: var(--ei-cyan);
        }

    /* =========================================================
       ELEVATE AI ORB
       ========================================================= */

    .ei-ai-root {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 9999;
        font-family: inherit;
    }

    .ei-ai-window {
        position: absolute;
        right: 0;
        bottom: 72px;
        width: min(390px, calc(100vw - 30px));
        overflow: hidden;
        border: 1px solid rgba(34,211,238,.22);
        border-radius: 22px;
        background: radial-gradient( circle at 85% 0%, rgba(139,92,246,.13), transparent 35% ), linear-gradient( 145deg, rgba(10,16,30,.98), rgba(7,12,23,.98) );
        box-shadow: 0 25px 80px rgba(0,0,0,.48), 0 0 45px rgba(34,211,238,.08), inset 0 1px 0 rgba(255,255,255,.05);
        opacity: 0;
        transform: translateY(15px) scale(.97);
        pointer-events: none;
        transition: .25s ease;
    }

    .ei-ai-root.open .ei-ai-window {
        opacity: 1;
        transform: translateY(0) scale(1);
        pointer-events: auto;
    }

    .ei-ai-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 15px;
        border-bottom: 1px solid rgba(255,255,255,.055);
        background: rgba(255,255,255,.018);
    }

    .ei-ai-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        flex: 1;
    }

    .ei-ai-orb-mini {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: radial-gradient( circle at 35% 30%, #fff 0 4%, #67e8f9 12%, #22d3ee 34%, #8b5cf6 67%, #111827 70% );
        box-shadow: 0 0 20px rgba(34,211,238,.42), 0 0 35px rgba(139,92,246,.22);
        animation: eiOrbPulse 2.4s ease-in-out infinite;
    }

    .ei-ai-brand strong {
        display: block;
        color: #fff;
        font-size: 11px;
        letter-spacing: 1.1px;
    }

    .ei-ai-brand span {
        display: block;
        margin-top: 2px;
        color: #71819b;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .ei-ai-online {
        display: flex;
        align-items: center;
        gap: 5px;
        color: #6ee7b7;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .ei-ai-online-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #34d399;
        box-shadow: 0 0 8px #34d399;
    }

    .ei-ai-close {
        width: 27px;
        height: 27px;
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 8px;
        background: rgba(255,255,255,.035);
        color: #8493ad;
        cursor: pointer;
    }

    .ei-ai-body {
        padding: 17px;
    }

    .ei-ai-scope {
        margin-bottom: 12px;
        color: #71819b;
        font-size: 8px;
        line-height: 1.5;
    }

    .ei-ai-thinking {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 10px;
        color: #22d3ee;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: 1.1px;
    }

    .ei-ai-dots {
        display: flex;
        gap: 3px;
    }

        .ei-ai-dots span {
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: #22d3ee;
            animation: eiThinking 1s infinite;
        }

            .ei-ai-dots span:nth-child(2) {
                animation-delay: .15s;
            }

            .ei-ai-dots span:nth-child(3) {
                animation-delay: .3s;
            }

    .ei-ai-message {
        padding: 14px;
        border: 1px solid rgba(34,211,238,.12);
        border-radius: 14px;
        background: rgba(34,211,238,.035);
        transition: .2s ease;
    }

        .ei-ai-message.attention {
            border-color: rgba(251,113,133,.16);
            background: rgba(251,113,133,.035);
        }

        .ei-ai-message.good {
            border-color: rgba(52,211,153,.14);
            background: rgba(52,211,153,.03);
        }

        .ei-ai-message.recommendation {
            border-color: rgba(139,92,246,.18);
            background: rgba(139,92,246,.04);
        }

    .ei-ai-label {
        margin-bottom: 7px;
        color: #22d3ee;
        font-size: 7px;
        font-weight: 900;
        letter-spacing: 1.2px;
    }

    .ei-ai-message.attention .ei-ai-label {
        color: #fb7185;
    }

    .ei-ai-message.good .ei-ai-label {
        color: #6ee7b7;
    }

    .ei-ai-message.recommendation .ei-ai-label {
        color: #a78bfa;
    }

    .ei-ai-text {
        color: #c4cfdf;
        font-size: 10px;
        line-height: 1.65;
    }

    .ei-ai-progress {
        height: 2px;
        margin-top: 14px;
        overflow: hidden;
        border-radius: 99px;
        background: rgba(255,255,255,.06);
    }

    .ei-ai-progress-bar {
        width: 0;
        height: 100%;
        background: linear-gradient( 90deg, #22d3ee, #8b5cf6 );
        box-shadow: 0 0 10px rgba(34,211,238,.4);
        transition: width .3s ease;
    }

    .ei-ai-counter {
        margin-top: 7px;
        color: #586981;
        font-size: 7px;
        font-weight: 800;
        text-align: right;
        letter-spacing: .7px;
    }

    .ei-ai-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 11px 15px;
        border-top: 1px solid rgba(255,255,255,.055);
    }

    .ei-ai-nav {
        display: flex;
        gap: 5px;
    }

    .ei-ai-btn,
    .ei-ai-action {
        min-height: 29px;
        padding: 7px 9px;
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 8px;
        background: rgba(255,255,255,.035);
        color: #9eacc0;
        font-size: 7px;
        font-weight: 800;
        cursor: pointer;
        text-decoration: none;
    }

        .ei-ai-btn:hover,
        .ei-ai-action:hover {
            color: #fff;
            border-color: rgba(34,211,238,.24);
        }

        .ei-ai-btn:disabled {
            opacity: .3;
            cursor: not-allowed;
        }

    .ei-ai-action {
        color: #67e8f9;
        border-color: rgba(34,211,238,.14);
    }

    .ei-ai-orb-button {
        position: relative;
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(34,211,238,.28);
        border-radius: 50%;
        background: radial-gradient( circle at 34% 28%, rgba(255,255,255,.95) 0 3%, rgba(103,232,249,.95) 8%, rgba(34,211,238,.75) 25%, rgba(139,92,246,.8) 55%, rgba(7,11,20,.98) 68% );
        color: #fff;
        box-shadow: 0 0 0 5px rgba(34,211,238,.025), 0 0 30px rgba(34,211,238,.24), 0 12px 35px rgba(0,0,0,.35);
        cursor: pointer;
        transition: .25s ease;
    }

        .ei-ai-orb-button:hover {
            transform: scale(1.06);
            box-shadow: 0 0 0 7px rgba(34,211,238,.035), 0 0 42px rgba(34,211,238,.34), 0 15px 40px rgba(0,0,0,.4);
        }

    .ei-ai-orb-symbol {
        font-size: 22px;
        text-shadow: 0 0 14px rgba(255,255,255,.75);
    }

    .ei-ai-orb-label {
        position: absolute;
        right: 67px;
        bottom: 14px;
        white-space: nowrap;
        padding: 6px 9px;
        border: 1px solid rgba(34,211,238,.12);
        border-radius: 8px;
        background: rgba(7,12,23,.9);
        color: #8da0bb;
        font-size: 7px;
        font-weight: 900;
        letter-spacing: 1px;
        opacity: .85;
    }

    /* =========================================================
       ANIMATIONS
       ========================================================= */

    @@keyframes eiOrbPulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.04);
        }
    }

    @@keyframes eiThinking {
        0%, 80%, 100% {
            opacity: .25;
            transform: translateY(0);
        }

        40% {
            opacity: 1;
            transform: translateY(-2px);
        }
    }

    @@keyframes insightFloat {
        0%, 100% {
            transform: translateY(0) rotate(0deg);
        }

        50% {
            transform: translateY(-8px) rotate(5deg);
        }
    }

    @@keyframes onlinePulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .35;
        }
    }

    /* =========================================================
