@using ElevateED.Models
@{
    ViewBag.Title = "Request a Donation Item";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewBag.ActivePage = "donations";
    ViewBag.ActiveTab = "request";

    var categories = (List<DonationCategory>)ViewBag.Categories;
    var urgencyContexts = (List<KeyValuePair<string, RequestPriority>>)ViewBag.UrgencyContexts;
}

<style>
    .page-header { margin-bottom: 20px; }
    .page-header h1 { font-size: 24px; font-weight: 700; color: var(--gray-900, #111827); display: flex; align-items: center; gap: 10px; }
    .page-header p { color: var(--gray-500, #6b7280); margin-top: 4px; font-size: 14px; }

    .wizard-steps { display: flex; gap: 8px; margin-bottom: 24px; }
    .wizard-step { flex: 1; text-align: center; padding: 10px; border-radius: 10px; background: var(--gray-100, #f3f4f6); color: var(--gray-500, #6b7280); font-size: 12px; font-weight: 600; }
    .wizard-step.done { background: #d1fae5; color: #065f46; }

    .item-card {
        background: white; border: 1px solid var(--gray-200, #e5e7eb); border-radius: 16px;
        padding: 24px; margin-bottom: 20px; position: relative;
        border-left: 4px solid var(--primary, #4f46e5);
    }
    .item-card-title { font-size: 15px; font-weight: 700; color: var(--gray-900, #111827); margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; }
    .btn-remove-item { background: #fee2e2; color: #991b1b; border: none; border-radius: 8px; padding: 6px 12px; font-size: 12px; font-weight: 600; cursor: pointer; }
    .btn-remove-item:hover { background: #fecaca; }

    .form-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 16px; }
    .form-group label { display: block; font-size: 12px; font-weight: 600; color: var(--gray-600, #4b5563); margin-bottom: 6px; }
    .form-group select, .form-group input[type="hidden"] {
        width: 100%; padding: 10px 14px; border: 1px solid var(--gray-300, #d1d5db); border-radius: 10px; font-size: 13px;
        font-family: inherit; background: white;
        -webkit-appearance: none; -moz-appearance: none; appearance: none;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path d='M0 0 L5 6 L10 0 Z' fill='%236b7280'/></svg>");
        background-repeat: no-repeat; background-position: right 14px center; padding-right: 32px;
    }
    .form-group select:focus { outline: none; border-color: var(--primary, #4f46e5); }
    .category-fields { display: none; }
    .category-fields.visible { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 16px; }

    .urgency-options { display: grid; gap: 10px; }
    .urgency-option {
        display: flex; align-items: flex-start; gap: 12px; padding: 12px 16px; border: 1.5px solid var(--gray-200, #e5e7eb);
        border-radius: 12px; cursor: pointer; transition: all 0.15s;
    }
    .urgency-option:hover { border-color: var(--primary-light, #6366f1); }
    .urgency-option.selected { border-color: var(--primary, #4f46e5); background: #f5f3ff; }
    .urgency-option input { margin-top: 3px; }
    .urgency-option .uo-text { font-size: 13px; color: var(--gray-700, #374151); }

    .btn-add-item {
        width: 100%; padding: 14px; border: 2px dashed var(--gray-300, #d1d5db); border-radius: 14px;
        background: var(--gray-50, #f9fafb); color: var(--gray-500, #6b7280); font-weight: 600; font-size: 13px;
        cursor: pointer; margin-bottom: 24px;
    }
    .btn-add-item:hover { border-color: var(--primary, #4f46e5); color: var(--primary, #4f46e5); }

    .submit-bar { display: flex; justify-content: flex-end; gap: 12px; }
    .btn-submit {
        background: linear-gradient(135deg, var(--primary, #4f46e5), #8b5cf6); color: white; border: none;
        padding: 14px 32px; border-radius: 12px; font-weight: 700; font-size: 14px; cursor: pointer;
    }
    .btn-submit:hover { opacity: 0.92; }
    .btn-cancel { background: white; border: 1px solid var(--gray-300, #d1d5db); color: var(--gray-600, #4b5563); padding: 14px 24px; border-radius: 12px; font-weight: 600; font-size: 14px; text-decoration: none; }

    .alert-box { padding: 14px 18px; border-radius: 12px; margin-bottom: 20px; font-size: 13px; }
    .alert-error { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
</style>

@{ Html.RenderPartial("_DonationSubNav"); }

<div class="page-header">
    <h1><i class="fas fa-hand-paper" style="color: var(--primary, #4f46e5);"></i> Request a Donation Item</h1>
    <p>Add every item you need below &mdash; each one joins its own category's priority queue (UC01). Everything is picked from a list, nothing needs to be typed.</p>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert-box alert-error"><i class="fas fa-exclamation-circle"></i> @TempData["Error"]</div>
}

<form id="requestForm" method="post" action="@Url.Action("RequestDonation", "Donation")">
    @Html.AntiForgeryToken()
    <input type="hidden" name="itemsJson" id="itemsJson" />

    <div id="itemsContainer"></div>

    <button type="button" class="btn-add-item" id="btnAddItem"><i class="fas fa-plus-circle"></i> Add Another Item</button>

    <div class="submit-bar">
        <a href="@Url.Action("Dashboard", "Donation")" class="btn-cancel">Cancel</a>
        <button type="submit" class="btn-submit" id="btnSubmit"><i class="fas fa-paper-plane"></i> Submit Request</button>
    </div>
</form>

<template id="itemTemplate">
    <div class="item-card" data-index="__INDEX__">
        <div class="item-card-title">
            <span><i class="fas fa-box"></i> Item #<span class="item-number">__NUM__</span></span>
            <button type="button" class="btn-remove-item btn-remove-item-action"><i class="fas fa-trash"></i> Remove</button>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Category</label>
                <select class="f-category">
                    @foreach (var c in categories)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Item Name</label>
                <select class="f-itemname"></select>
            </div>
            <div class="form-group">
                <label>Quantity</label>
                <select class="f-quantity">
                    @for (var q = 1; q <= 10; q++)
                    {
                        <option value="@q">@q</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-group" style="margin-bottom:16px;">
            <label>Any extra detail? (optional)</label>
            <select class="f-description">
                <option value="">No additional details</option>
                <option value="Any condition is fine">Any condition is fine</option>
                <option value="New item preferred">New item preferred</option>
                <option value="Gently used is fine">Gently used is fine</option>
                <option value="Needed urgently for an upcoming assessment">Needed urgently for an upcoming assessment</option>
                <option value="Hand-me-down welcome">Hand-me-down welcome</option>
                <option value="Specific size or fit required &mdash; see details above">Specific size or fit required &mdash; see details above</option>
            </select>
        </div>

        <!-- Textbook fields -->
        <div class="category-fields cf-Textbook">
            <div class="form-group">
                <label>Resource Type</label>
                <select class="f-booktitle">
                    <option value="Learner's Book">Learner's Book</option>
                    <option value="Workbook">Workbook</option>
                    <option value="Study Guide">Study Guide</option>
                    <option value="Teacher's Guide">Teacher's Guide</option>
                    <option value="Novel / Reader">Novel / Reader</option>
                    <option value="Atlas">Atlas</option>
                    <option value="Dictionary">Dictionary</option>
                    <option value="Other Textbook/Resource">Other Textbook/Resource</option>
                </select>
            </div>
            <div class="form-group">
                <label>Subject</label>
                <select class="f-subject"></select>
            </div>
            <div class="form-group">
                <label>Grade Level</label>
                <select class="f-gradelevel"></select>
            </div>
            <div class="form-group">
                <label>ISBN</label>
                <select class="f-isbn"><option value="">Not specified</option></select>
            </div>
        </div>

        <!-- Clothing fields -->
        <div class="category-fields cf-Clothing">
            <div class="form-group">
                <label>Size</label>
                <select class="f-clothingsize"></select>
            </div>
            <div class="form-group">
                <label>Type</label>
                <select class="f-clothingtype"></select>
            </div>
            <div class="form-group"><label>Gender</label>
                <select class="f-gender"><option value="">Any</option><option value="Male">Male</option><option value="Female">Female</option><option value="Unisex">Unisex</option></select>
            </div>
        </div>

        <!-- Footwear fields -->
        <div class="category-fields cf-Footwear">
            <div class="form-group">
                <label>Shoe Size</label>
                <select class="f-clothingsize"></select>
            </div>
            <div class="form-group"><label>Gender</label>
                <select class="f-gender"><option value="">Any</option><option value="Male">Male</option><option value="Female">Female</option><option value="Unisex">Unisex</option></select>
            </div>
        </div>

        <!-- Stationery fields -->
        <div class="category-fields cf-Stationery">
            <div class="form-group">
                <label>Stationery Type</label>
                <select class="f-stationerytype"></select>
            </div>
            <div class="form-group">
                <label>Brand Preference</label>
                <select class="f-brandpreference">
                    <option value="">No preference</option>
                    <option value="Well-known brand preferred">Well-known brand preferred</option>
                    <option value="Store brand or generic is fine">Store brand or generic is fine</option>
                </select>
            </div>
        </div>

        <!-- Other fields -->
        <div class="category-fields cf-Other">
            <div class="form-group">
                <label>Sub-category</label>
                <select class="f-itemsubcategory"></select>
            </div>
            <div class="form-group">
                <label>Size / Specifications</label>
                <select class="f-sizespec">
                    <option value="">Not applicable</option>
                    <option value="Small">Small</option>
                    <option value="Medium">Medium</option>
                    <option value="Large">Large</option>
                    <option value="Extra Large">Extra Large</option>
                </select>
            </div>
        </div>

        <div class="form-group" style="margin-bottom:0;">
            <label>How urgent is this? (UC01 step 4)</label>
            <div class="urgency-options f-urgency-group">
                @{ var uIdx = 0; }
                @foreach (var u in urgencyContexts)
                {
                    <label class="urgency-option">
                        <input type="radio" class="f-urgency-radio" name="urgency___INDEX__" value="@u.Value" data-reason="@u.Key" />
                        <span class="uo-text">@u.Key</span>
                    </label>
                    uIdx++;
                }
            </div>
        </div>
    </div>
</template>

<script>
    var CATEGORY_LIST = @Html.Raw(Json.Encode(categories.Select(c => c.ToString()).ToList()));
    var itemCount = 0;

    // Preset option lists — the whole point is that nothing in this form
    // needs to be typed, so every field (even "item name") is a dropdown.
    var ITEM_NAME_OPTIONS = {
        Textbook: ["Mathematics Textbook", "Mathematical Literacy Textbook", "English Textbook", "Afrikaans Textbook", "isiZulu Textbook", "Life Sciences Textbook", "Physical Sciences Textbook", "Natural Sciences Textbook", "Social Sciences Textbook", "History Textbook", "Geography Textbook", "Accounting Textbook", "Business Studies Textbook", "Economics Textbook", "Economic & Management Sciences Textbook", "Technology Textbook", "Information Technology Textbook", "Computer Applications Technology Textbook", "Life Orientation Textbook", "Other Textbook"],
        Clothing: ["Blazer", "School Jersey / Jumper", "Shirt (Long Sleeve)", "Shirt (Short Sleeve)", "Trousers", "Shorts", "Skirt", "Pinafore / Dress", "Tracksuit", "PE Shirt", "PE Shorts", "Tie", "Other Clothing Item"],
        Footwear: ["School Shoes", "Sports Shoes", "Sandals", "Boots", "Other Footwear"],
        Stationery: ["Calculator (Scientific)", "Calculator (Basic)", "Geometry Set", "Pens (Pack)", "Pencils (Pack)", "Exercise Books", "Ruler", "Eraser", "Sharpener", "Highlighters", "School Bag / Backpack", "Pencil Case", "Colouring Pencils / Crayons", "Other Stationery"],
        Other: ["Bag / Backpack", "Lunch Box", "Water Bottle", "Sports Equipment", "Musical Instrument", "Art Supplies", "Electronic Device", "Furniture", "Other Item"]
    };

    var SUBJECT_OPTIONS = ["Mathematics", "Mathematical Literacy", "English Home Language", "English First Additional Language", "Afrikaans Home Language", "Afrikaans First Additional Language", "isiZulu", "Life Orientation", "Life Sciences", "Physical Sciences", "Natural Sciences", "Social Sciences", "History", "Geography", "Accounting", "Business Studies", "Economics", "Economic & Management Sciences", "Technology", "Information Technology", "Computer Applications Technology", "Agricultural Sciences", "Consumer Studies", "Tourism", "Dramatic Arts", "Visual Arts", "Music", "Creative Arts", "Other"];

    var GRADE_OPTIONS = ["Grade R", "Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5", "Grade 6", "Grade 7", "Grade 8", "Grade 9", "Grade 10", "Grade 11", "Grade 12"];

    var CLOTHING_SIZE_OPTIONS = ["Age 3-4", "Age 5-6", "Age 7-8", "Age 9-10", "Age 11-12", "Age 13-14", "Age 15-16", "Adult XS", "Adult S", "Adult M", "Adult L", "Adult XL", "Adult XXL"];

    var CLOTHING_TYPE_OPTIONS = ["Blazer", "School Jersey / Jumper", "Shirt (Long Sleeve)", "Shirt (Short Sleeve)", "Trousers", "Shorts", "Skirt", "Pinafore / Dress", "Tracksuit", "PE Shirt", "PE Shorts", "Tie", "Other"];

    var SHOE_SIZE_OPTIONS = ["Size 1", "Size 2", "Size 3", "Size 4", "Size 5", "Size 6", "Size 7", "Size 8", "Size 9", "Size 10", "Size 11", "Size 12", "Size 13"];

    var STATIONERY_TYPE_OPTIONS = ["Calculator (Scientific)", "Calculator (Basic)", "Geometry Set", "Pens (Pack)", "Pencils (Pack)", "Exercise Books", "Ruler", "Eraser", "Sharpener", "Highlighters", "School Bag / Backpack", "Pencil Case", "Colouring Pencils / Crayons", "Other"];

    var SUBCATEGORY_OPTIONS = ["Bag / Backpack", "Lunch Box", "Water Bottle", "Sports Equipment", "Musical Instrument", "Art Supplies", "Electronic Device", "Furniture", "Other"];

    function fillSelect(select, options) {
        select.innerHTML = '';
        options.forEach(function (opt) {
            var o = document.createElement('option');
            o.value = opt;
            o.textContent = opt;
            select.appendChild(o);
        });
    }

    function categoryToItemType(cat) {
        switch (cat) {
            case 'Textbook': return 'Book';
            case 'Clothing': return 'Clothing';
            case 'Footwear': return 'Clothing';
            case 'Stationery': return 'Stationery';
            default: return 'Other';
        }
    }

    function updateCategoryFields(card) {
        var cat = card.querySelector('.f-category').value;
        var panels = card.querySelectorAll('.category-fields');
        panels.forEach(function (p) { p.classList.remove('visible'); });
        var match = card.querySelector('.cf-' + cat);
        if (match) match.classList.add('visible');

        fillSelect(card.querySelector('.f-itemname'), ITEM_NAME_OPTIONS[cat] || ITEM_NAME_OPTIONS.Other);
    }

    function populateStaticSelects(card) {
        var subjectEl = card.querySelector('.f-subject');
        if (subjectEl) fillSelect(subjectEl, SUBJECT_OPTIONS);

        var gradeEl = card.querySelector('.f-gradelevel');
        if (gradeEl) fillSelect(gradeEl, GRADE_OPTIONS);

        card.querySelectorAll('.cf-Clothing .f-clothingsize').forEach(function (el) { fillSelect(el, CLOTHING_SIZE_OPTIONS); });
        card.querySelectorAll('.cf-Footwear .f-clothingsize').forEach(function (el) { fillSelect(el, SHOE_SIZE_OPTIONS); });

        var clothingTypeEl = card.querySelector('.f-clothingtype');
        if (clothingTypeEl) fillSelect(clothingTypeEl, CLOTHING_TYPE_OPTIONS);

        var stationeryTypeEl = card.querySelector('.f-stationerytype');
        if (stationeryTypeEl) fillSelect(stationeryTypeEl, STATIONERY_TYPE_OPTIONS);

        var subcatEl = card.querySelector('.f-itemsubcategory');
        if (subcatEl) fillSelect(subcatEl, SUBCATEGORY_OPTIONS);
    }

    function addItemCard() {
        itemCount++;
        var tpl = document.getElementById('itemTemplate').innerHTML;
        tpl = tpl.replace(/__INDEX__/g, itemCount).replace(/__NUM__/g, itemCount);
        var wrapper = document.createElement('div');
        wrapper.innerHTML = tpl;
        var card = wrapper.firstElementChild;
        document.getElementById('itemsContainer').appendChild(card);

        populateStaticSelects(card);

        card.querySelector('.f-category').addEventListener('change', function () { updateCategoryFields(card); });
        updateCategoryFields(card);

        card.querySelectorAll('.urgency-option').forEach(function (opt) {
            opt.addEventListener('click', function () {
                card.querySelectorAll('.urgency-option').forEach(function (o) { o.classList.remove('selected'); });
                opt.classList.add('selected');
            });
        });

        card.querySelector('.btn-remove-item-action').addEventListener('click', function () {
            if (document.querySelectorAll('.item-card').length <= 1) {
                alert('You need at least one item in your request.');
                return;
            }
            card.remove();
            renumberCards();
        });
    }

    function renumberCards() {
        var cards = document.querySelectorAll('.item-card');
        cards.forEach(function (card, i) { card.querySelector('.item-number').textContent = i + 1; });
    }

    document.getElementById('btnAddItem').addEventListener('click', addItemCard);
    addItemCard(); // start with one item

    document.getElementById('requestForm').addEventListener('submit', function (e) {
        var cards = document.querySelectorAll('.item-card');
        var items = [];
        var valid = true;

        cards.forEach(function (card) {
            var category = card.querySelector('.f-category').value;
            var itemName = card.querySelector('.f-itemname').value;
            var urgencyRadio = card.querySelector('.f-urgency-radio:checked');

            if (!itemName) { valid = false; }
            if (!urgencyRadio) { valid = false; }

            var get = function (sel) { var el = card.querySelector(sel); return el ? el.value : ''; };

            items.push({
                Category: category,
                ItemType: categoryToItemType(category),
                ItemName: itemName,
                Description: get('.f-description'),
                BookTitle: get('.f-booktitle'),
                Subject: get('.f-subject'),
                GradeLevel: get('.f-gradelevel'),
                ISBN: get('.f-isbn'),
                ClothingSize: get('.f-clothingsize'),
                ClothingType: get('.f-clothingtype'),
                Gender: get('.f-gender'),
                StationeryType: get('.f-stationerytype'),
                BrandPreference: get('.f-brandpreference'),
                ItemSubCategory: get('.f-itemsubcategory'),
                SizeSpecifications: get('.f-sizespec'),
                QuantityRequested: parseInt(get('.f-quantity') || '1', 10),
                Priority: urgencyRadio ? urgencyRadio.value : 'Medium',
                UrgencyReason: urgencyRadio ? urgencyRadio.getAttribute('data-reason') : ''
            });
        });

        if (!valid || items.length === 0) {
            e.preventDefault();
            alert('Please give every item a name and select how urgent it is before submitting.');
            return false;
        }

        document.getElementById('itemsJson').value = JSON.stringify(items);
    });
</script>
