@model ElevateED.ViewModels.AdminCareerOverviewViewModel
@{
    ViewBag.Title = "Career Guidance";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section SidebarNav {
    @Html.Partial("_AdminSidebar")
}

@section Styles {
    <style>
        .page-title { font-size: 24px; font-weight: 700; color: var(--gray-900); margin-bottom: 4px; }
        .page-sub { color: var(--gray-500); margin-bottom: 24px; }
        .stat-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 18px; margin-bottom: 26px; }
        .stat { background: white; border-radius: 14px; padding: 22px; box-shadow: var(--shadow); border: 1px solid var(--gray-100); }
        .stat .icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; color: white; margin-bottom: 12px; }
        .stat .val { font-size: 30px; font-weight: 800; color: var(--gray-900); }
        .stat .lab { font-size: 13px; color: var(--gray-500); }
        .manage-links { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 26px; }
        .mbtn { display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px; border-radius: 12px; font-weight: 600; font-size: 14px; text-decoration: none; background: var(--primary); color: white; }
        .mbtn.light { background: white; color: var(--gray-700); border: 1px solid var(--gray-200); }
        .panel { background: white; border-radius: 16px; padding: 24px; box-shadow: var(--shadow); border: 1px solid var(--gray-100); }
        .panel h3 { font-size: 16px; color: var(--gray-800); margin-bottom: 18px; }
        .alert-soft { padding: 14px 18px; border-radius: 12px; margin-bottom: 20px; font-size: 14px; }
        .alert-success { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
        .chart-wrap { position: relative; height: 340px; }
    </style>
}

<div class="page-title"><i class="fas fa-compass" style="color: var(--primary);"></i> Career Guidance</div>
<div class="page-sub">Manage career fields, careers, and the interest quiz. Review what learners are interested in.</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-soft alert-success"><i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]</div>
}

<div class="stat-row">
    <div class="stat">
        <div class="icon" style="background: linear-gradient(135deg,#4f46e5,#6366f1);"><i class="fas fa-layer-group"></i></div>
        <div class="val">@Model.FieldCount</div>
        <div class="lab">Career fields</div>
    </div>
    <div class="stat">
        <div class="icon" style="background: linear-gradient(135deg,#10b981,#34d399);"><i class="fas fa-briefcase"></i></div>
        <div class="val">@Model.CareerCount</div>
        <div class="lab">Careers</div>
    </div>
    <div class="stat">
        <div class="icon" style="background: linear-gradient(135deg,#f59e0b,#fbbf24);"><i class="fas fa-clipboard-question"></i></div>
        <div class="val">@Model.QuestionCount</div>
        <div class="lab">Quiz questions</div>
    </div>
    <div class="stat">
        <div class="icon" style="background: linear-gradient(135deg,#ec4899,#f472b6);"><i class="fas fa-user-check"></i></div>
        <div class="val">@Model.QuizzesTaken</div>
        <div class="lab">Quizzes taken</div>
    </div>
</div>

<div class="manage-links">
    <a href="@Url.Action("Fields")" class="mbtn"><i class="fas fa-layer-group"></i> Manage Fields</a>
    <a href="@Url.Action("Careers")" class="mbtn"><i class="fas fa-briefcase"></i> Manage Careers</a>
    <a href="@Url.Action("Questions")" class="mbtn"><i class="fas fa-clipboard-question"></i> Manage Quiz</a>
</div>

<div class="panel">
    <h3>Learner interest by field <span style="font-weight:400;color:var(--gray-400);font-size:13px;">(top field per learner, latest quiz)</span></h3>
    <div class="chart-wrap">
        <canvas id="interestChart"></canvas>
    </div>
</div>

@section Scripts {
    <script>
        var labels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.InterestDistribution.Select(x => x.FieldName)));
        var values = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.InterestDistribution.Select(x => x.Count)));

        new Chart(document.getElementById('interestChart'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Learners',
                    data: values,
                    backgroundColor: ['#4f46e5','#10b981','#f59e0b','#ec4899','#8b5cf6','#14b8a6','#ef4444','#3b82f6','#f97316','#06b6d4'],
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
    </script>
}
