<style>
    .cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }

    .career-card {
        background: white; border-radius: 16px; padding: 20px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05); border: 1px solid var(--gray-100);
        border-top: 4px solid var(--gray-300);
        display: flex; flex-direction: column; gap: 10px; transition: all 0.2s;
    }
    .career-card:hover { transform: translateY(-4px); box-shadow: 0 10px 28px rgba(0,0,0,0.1); }
    .career-card.v-qualify { border-top-color: var(--success); }
    .career-card.v-close { border-top-color: var(--warning); }
    .career-card.v-missing { border-top-color: var(--danger); }
    .career-card.v-nodata { border-top-color: var(--gray-300); }

    .cc-top { display: flex; justify-content: space-between; align-items: center; }
    .cc-field { font-size: 12px; color: var(--gray-500); font-weight: 600; display: flex; align-items: center; gap: 6px; }
    .bookmark-form { margin: 0; }
    .bookmark-btn { background: none; border: none; cursor: pointer; font-size: 18px; color: var(--gray-400); padding: 4px; }
    .bookmark-btn.active { color: var(--primary); }
    .bookmark-btn:hover { color: var(--primary); }

    .cc-title { font-size: 18px; font-weight: 700; color: var(--gray-900); text-decoration: none; }
    .cc-title:hover { color: var(--primary); }
    .cc-qual { font-size: 13px; color: var(--gray-500); }

    .cc-verdict { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 50px; font-size: 13px; font-weight: 600; align-self: flex-start; }
    .cc-verdict.v-qualify { background: #ecfdf5; color: #065f46; }
    .cc-verdict.v-close { background: #fffbeb; color: #92400e; }
    .cc-verdict.v-missing { background: #fef2f2; color: #991b1b; }
    .cc-verdict.v-nodata { background: var(--gray-100); color: var(--gray-500); }

    .cc-meta { display: flex; gap: 16px; }
    .cc-aps { display: flex; align-items: center; gap: 8px; font-size: 13px; }
    .cc-aps-label { color: var(--gray-500); }
    .cc-aps-val { font-weight: 700; color: var(--gray-800); font-size: 15px; }
    .cc-aps-you { padding: 2px 8px; border-radius: 6px; font-size: 12px; font-weight: 600; }
    .cc-aps-you.ok { background: #ecfdf5; color: #065f46; }
    .cc-aps-you.under { background: #fef2f2; color: #991b1b; }

    .cc-gaps { display: flex; flex-direction: column; gap: 6px; background: var(--gray-50); border-radius: 10px; padding: 10px 12px; }
    .cc-gap { font-size: 12px; color: var(--gray-600); display: flex; align-items: flex-start; gap: 6px; }
    .cc-gap i { color: var(--warning); margin-top: 2px; }

    .cc-link { font-size: 13px; font-weight: 600; color: var(--primary); text-decoration: none; margin-top: auto; }
    .cc-link:hover { text-decoration: underline; }
</style>
