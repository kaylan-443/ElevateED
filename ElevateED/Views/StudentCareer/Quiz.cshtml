@model ElevateED.ViewModels.InterestQuizViewModel
@{
    ViewBag.Title = "Interest Quiz - ElevateED";
}

<style>
    .content { padding: 32px; max-width: 820px; }
    .page-head { margin-bottom: 8px; }
    .page-head h1 { font-size: 26px; color: var(--gray-900); }
    .page-head p { color: var(--gray-500); margin-top: 4px; }
    .back-link { color: var(--primary); text-decoration: none; font-size: 14px; font-weight: 600; }

    .intro {
        background: linear-gradient(135deg,#4f46e5,#6366f1); color: white;
        border-radius: 16px; padding: 20px 24px; margin: 16px 0 24px; font-size: 14px; line-height: 1.6;
    }

    .q-card { background: white; border-radius: 14px; padding: 20px 24px; box-shadow: 0 2px 12px rgba(0,0,0,0.05); border: 1px solid var(--gray-100); margin-bottom: 16px; }
    .q-num { font-size: 12px; color: var(--primary); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
    .q-text { font-size: 16px; color: var(--gray-800); font-weight: 600; margin: 6px 0 16px; }

    .likert { display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
    .likert label {
        flex: 1; min-width: 90px; text-align: center; cursor: pointer;
        border: 2px solid var(--gray-200); border-radius: 12px; padding: 12px 6px;
        font-size: 12px; font-weight: 600; color: var(--gray-500); transition: all 0.15s;
    }
    .likert input { display: none; }
    .likert label:hover { border-color: var(--primary-light); }
    .likert input:checked + span { }
    .likert label.sel { border-color: var(--primary); background: var(--primary-soft); color: var(--primary-dark); }
    .likert .dot { display: block; font-size: 18px; margin-bottom: 4px; }

    .submit-bar { position: sticky; bottom: 0; background: var(--gray-50); padding: 16px 0; margin-top: 8px; }
    .btn { display: inline-flex; align-items: center; gap: 8px; padding: 14px 28px; border-radius: 12px; font-weight: 700; font-size: 15px; border: none; cursor: pointer; }
    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: var(--primary-dark); }
    .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
    .progress-note { font-size: 13px; color: var(--gray-500); margin-left: 14px; }
    .alert-soft { padding: 14px 18px; border-radius: 12px; margin-bottom: 20px; font-size: 14px; }
    .alert-error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
</style>

<div class="app-container">
    @Html.Partial("_StudentSidebar")
    <main class="main-content">
        <header class="top-header">
            <div class="header-right">
                <a href="@Url.Action("Index")" class="back-link"><i class="fas fa-arrow-left"></i> Back to dashboard</a>
            </div>
        </header>

        <div class="content">
            <div class="page-head">
                <h1><i class="fas fa-clipboard-question" style="color: var(--accent);"></i> Career Interest Quiz</h1>
                <p>There are no right or wrong answers — just be honest.</p>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert-soft alert-error"><i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]</div>
            }

            <div class="intro">
                <i class="fas fa-lightbulb"></i> Rate how much you agree with each statement. When you're done we'll show the career
                <strong>fields</strong> that best match your interests, and careers within them that fit your marks.
            </div>

            <form action="@Url.Action("SubmitQuiz")" method="post" id="quizForm">
                @Html.AntiForgeryToken()

                @for (int i = 0; i < Model.Questions.Count; i++)
                {
                    var q = Model.Questions[i];
                    <div class="q-card">
                        <div class="q-num">Question @(i + 1) of @Model.Questions.Count</div>
                        <div class="q-text">@q.Text</div>
                        <input type="hidden" name="Answers[@i].QuestionId" value="@q.Id" />
                        <div class="likert">
                            @{
                                var opts = new[] {
                                    Tuple.Create(1, "😞", "Strongly Disagree"),
                                    Tuple.Create(2, "🙁", "Disagree"),
                                    Tuple.Create(3, "😐", "Neutral"),
                                    Tuple.Create(4, "🙂", "Agree"),
                                    Tuple.Create(5, "😀", "Strongly Agree")
                                };
                            }
                            @foreach (var opt in opts)
                            {
                                <label class="likert-opt">
                                    <input type="radio" name="Answers[@i].Score" value="@opt.Item1" required />
                                    <span class="dot">@opt.Item2</span>
                                    <span>@opt.Item3</span>
                                </label>
                            }
                        </div>
                    </div>
                }

                <div class="submit-bar">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-wand-magic-sparkles"></i> See my results</button>
                    <span class="progress-note" id="progressNote">0 of @Model.Questions.Count answered</span>
                </div>
            </form>
        </div>
    </main>
</div>

<script>
    (function () {
        var form = document.getElementById('quizForm');
        var total = @Model.Questions.Count;
        var note = document.getElementById('progressNote');

        form.addEventListener('change', function (e) {
            if (e.target.type === 'radio') {
                // Highlight selected option within its group.
                var group = e.target.closest('.likert');
                group.querySelectorAll('label').forEach(function (l) { l.classList.remove('sel'); });
                e.target.closest('label').classList.add('sel');

                // Update progress.
                var answered = form.querySelectorAll('input[type=radio]:checked').length;
                note.textContent = answered + ' of ' + total + ' answered';
            }
        });
    })();
</script>
