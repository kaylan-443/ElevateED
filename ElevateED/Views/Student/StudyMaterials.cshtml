@model List<ElevateED.ViewModels.SubjectMaterialViewModel>

@{
    ViewBag.Title = "Study Materials - ElevateED";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewBag.ActivePage = "studymaterials";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }


    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: var(--gray-50);
    }


















    .content-area {
        padding: 32px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 15px;
    }

        .page-header h1 {
            font-size: 26px;
            font-weight: 700;
            color: var(--gray-900);
        }

    .info-banner {
        background: linear-gradient(135deg, var(--success), #34d399);
        color: white;
        padding: 20px 24px;
        border-radius: 16px;
        margin-bottom: 24px;
    }

    .subject-card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        text-align: center;
        border: 1px solid var(--gray-200);
        transition: all 0.3s;
        cursor: pointer;
    }

        .subject-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px rgba(0,0,0,0.1);
            border-color: var(--success);
        }

    .subject-icon {
        width: 55px;
        height: 55px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 12px;
        font-size: 24px;
        color: white;
        background: var(--success);
    }

    .subject-name {
        font-size: 15px;
        font-weight: 600;
        color: var(--gray-900);
        margin-bottom: 6px;
    }

    .material-count {
        font-size: 12px;
        color: var(--gray-500);
    }

        .material-count span {
            font-weight: 700;
            color: var(--success);
        }

</style>

        <div class="content-area">
            <div class="page-header"><h1><i class="fas fa-book" style="color:var(--success);"></i> Study Materials</h1></div>
            <div class="info-banner">
                <h3><i class="fas fa-graduation-cap"></i> @ViewBag.StudentName</h3>
                <p>Class: @ViewBag.ClassName | Grade: @ViewBag.StudentGrade</p>
            </div>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;">
                @foreach (var subject in Model)
                {
                    <div class="subject-card" onclick="location.href='@Url.Action("SelectGrade", "Student", new { subject = subject.SubjectName })'">
                        <div class="subject-icon"><i class="@subject.Icon"></i></div>
                        <div class="subject-name">@subject.SubjectName</div>
                        <div class="material-count"><span>@subject.MaterialCount</span> available</div>
                    </div>
                }
            </div>
        </div>
<script>
    function toggleDropdown() { document.getElementById('profileDropdown').classList.toggle('show'); }
    document.addEventListener('click', function (e) { var c = document.querySelector('.profile-container'); var d = document.getElementById('profileDropdown'); if (c && !c.contains(e.target)) d.classList.remove('show'); });
</script>